//ClickFix persistence query
//
// What was left on the endpoint. This is the decision to return it to service.
let TimeToCheck = 14d;
let DeviceCheck = "";
let UserIdentityCheck = "";
//
let LolBins = dynamic(["powershell.exe","pwsh.exe","cmd.exe","mshta.exe","wscript.exe","cscript.exe","rundll32.exe","regsvr32.exe","curl.exe","certutil.exe","bitsadmin.exe","msiexec.exe"]);
let SuspectPaths = dynamic([@"\appdata\",@"\temp\",@"\programdata\",@"\public\",@"\downloads\",@"\users\public\"]);
//
union isfuzzy=true
    // Registry autorun keys.
    (DeviceRegistryEvents | where TimeGenerated >= ago(TimeToCheck) | where ActionType in~ ("RegistryValueSet","RegistryKeyCreated") | where RegistryKey contains @"CurrentVersion\Run" or RegistryKey contains @"CurrentVersion\RunOnce" or RegistryKey contains "Winlogon" or RegistryKey contains "Image File Execution Options" or RegistryKey contains @"Policies\Explorer\Run" or RegistryKey contains @"CurrentVersion\Shell Extensions" | extend Method = "Registry-Autorun", Actor = InitiatingProcessAccountName, Payload = RegistryValueData, Location = strcat(RegistryKey, "\\", RegistryValueName), SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // Scheduled tasks and services created from the command line.
    (DeviceProcessEvents | where TimeGenerated >= ago(TimeToCheck) | where FileName in~ ("schtasks.exe","sc.exe","at.exe","reg.exe","wmic.exe") | where ProcessCommandLine has_any ("create","add","/create","/sc","config") | extend Method = "Task-Service", Actor = AccountName, Payload = ProcessCommandLine, Location = FileName, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // PowerShell persistence: profile, WMI, scheduled tasks.
    (DeviceProcessEvents | where TimeGenerated >= ago(TimeToCheck) | where FileName in~ ("powershell.exe","pwsh.exe") | where ProcessCommandLine has_any ("New-ScheduledTask","Register-ScheduledTask","New-Service","Set-Service","profile.ps1","Register-WmiEvent","New-CimInstance","__EventFilter") | extend Method = "PowerShell-Persistence", Actor = AccountName, Payload = ProcessCommandLine, Location = FileName, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // Files dropped in the Startup folder.
    (DeviceFileEvents | where TimeGenerated >= ago(TimeToCheck) | where ActionType in~ ("FileCreated","FileModified","FileRenamed") | where FolderPath contains @"\Start Menu\Programs\Startup" | extend Method = "Startup-Folder", Actor = InitiatingProcessAccountName, Payload = strcat(FolderPath, " | SHA256=", SHA256, " | origin=", FileOriginUrl), Location = FileName, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // Executables written by a LOLBin into user-writable directories.
    (DeviceFileEvents | where TimeGenerated >= ago(TimeToCheck) | where ActionType in~ ("FileCreated","FileModified") | where InitiatingProcessFileName in~ (LolBins) | where FolderPath has_any (SuspectPaths) | where FileName endswith ".exe" or FileName endswith ".dll" or FileName endswith ".ps1" or FileName endswith ".bat" or FileName endswith ".vbs" or FileName endswith ".js" or FileName endswith ".hta" | extend Method = "LOLBin-Write", Actor = InitiatingProcessAccountName, Payload = strcat(FolderPath, " | SHA256=", SHA256, " | origin=", FileOriginUrl), Location = FileName, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine)
| where DeviceName contains DeviceCheck
| where Actor contains UserIdentityCheck
| project-rename EventTime = TimeGenerated
| project EventTime, Method, DeviceName, Actor, Location, Payload, SetBy, SetByCmd
| sort by EventTime desc
//
//| where SetBy in~ (LolBins)          // only what a LOLBin created, not an installer
//| summarize Methods = make_set(Method, 10), First = min(EventTime) by DeviceName  // one line per device

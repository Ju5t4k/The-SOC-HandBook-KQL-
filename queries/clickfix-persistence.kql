//ClickFix persistence query
//
// What the payload left on the endpoint. Decides whether the device can go back into service.
let TimeToCheck = 14d;
let DeviceCheck = "";
let UserIdentityCheck = "";
//
let LolBins = dynamic(["powershell.exe","pwsh.exe","cmd.exe","mshta.exe","wscript.exe","cscript.exe","rundll32.exe","regsvr32.exe","curl.exe","certutil.exe","bitsadmin.exe","msiexec.exe"]);
let SuspectPaths = dynamic([@"\appdata\",@"\temp\",@"\programdata\",@"\public\",@"\downloads\",@"\users\public\"]);
//
union isfuzzy=true
    // Run keys, Winlogon Userinit/Shell, IFEO debuggers.
    (DeviceRegistryEvents | where TimeGenerated >= ago(TimeToCheck) | where ActionType in~ ("RegistryValueSet","RegistryKeyCreated") | where RegistryKey contains @"CurrentVersion\Run" or RegistryKey contains @"Policies\Explorer\Run" or (RegistryKey contains "Winlogon" and RegistryValueName in~ ("Userinit","Shell","Notify")) or (RegistryKey contains "Image File Execution Options" and RegistryValueName in~ ("Debugger","GlobalFlag")) | extend Method = "Registry-Autorun", Actor = InitiatingProcessAccountName, Payload = RegistryValueData, Location = strcat(RegistryKey, "\\", RegistryValueName), SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // Tasks and services created from the command line.
    (DeviceProcessEvents | where TimeGenerated >= ago(TimeToCheck) | where FileName in~ ("schtasks.exe","sc.exe","at.exe","reg.exe","wmic.exe","bitsadmin.exe") | where ProcessCommandLine has_any ("create","add","/create","/sc","config","setnotifycmdline") | extend Method = "Task-Service", Actor = AccountName, Payload = ProcessCommandLine, Location = FileName, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // Tasks, services, profiles and WMI subscriptions created from PowerShell.
    (DeviceProcessEvents | where TimeGenerated >= ago(TimeToCheck) | where FileName in~ ("powershell.exe","pwsh.exe") | where ProcessCommandLine has_any ("New-ScheduledTask","Register-ScheduledTask","New-Service","Set-Service","profile.ps1","Register-WmiEvent","New-CimInstance","__EventFilter") | extend Method = "PowerShell-Persistence", Actor = AccountName, Payload = ProcessCommandLine, Location = FileName, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // Files in a Startup folder.
    (DeviceFileEvents | where TimeGenerated >= ago(TimeToCheck) | where ActionType in~ ("FileCreated","FileModified","FileRenamed") | where FolderPath contains @"\Start Menu\Programs\Startup" | extend Method = "Startup-Folder", Actor = InitiatingProcessAccountName, Payload = strcat(FolderPath, " | SHA256=", SHA256, " | origin=", FileOriginUrl), Location = FileName, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // Executables and scripts a LOLBin wrote into a user-writable folder.
    (DeviceFileEvents | where TimeGenerated >= ago(TimeToCheck) | where ActionType in~ ("FileCreated","FileModified") | where InitiatingProcessFileName in~ (LolBins) | where FolderPath has_any (SuspectPaths) | where FileName endswith ".exe" or FileName endswith ".dll" or FileName endswith ".ps1" or FileName endswith ".bat" or FileName endswith ".vbs" or FileName endswith ".js" or FileName endswith ".hta" | extend Method = "LOLBin-Write", Actor = InitiatingProcessAccountName, Payload = strcat(FolderPath, " | SHA256=", SHA256, " | origin=", FileOriginUrl), Location = FileName, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // COM hijack: a user-hive CLSID pointed at the attacker's code.
    (DeviceRegistryEvents | where TimeGenerated >= ago(TimeToCheck) | where ActionType in~ ("RegistryValueSet","RegistryKeyCreated") | where RegistryKey contains @"Classes\CLSID" | where RegistryKey contains "InprocServer32" or RegistryKey contains "LocalServer32" or RegistryKey contains "TreatAs" | extend Method = "COM-Hijack", Actor = InitiatingProcessAccountName, Payload = RegistryValueData, Location = strcat(RegistryKey, "\\", RegistryValueName), SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // AppInit DLLs, service DLLs, and the shell folders Windows starts from.
    (DeviceRegistryEvents | where TimeGenerated >= ago(TimeToCheck) | where ActionType in~ ("RegistryValueSet","RegistryKeyCreated") | where RegistryValueName in~ ("AppInit_DLLs","LoadAppInit_DLLs","ServiceDll") or (RegistryKey contains "User Shell Folders" and RegistryValueName in~ ("Startup","Common Startup")) or RegistryKey contains "StartupApproved" | extend Method = "Shell-Hijack", Actor = InitiatingProcessAccountName, Payload = RegistryValueData, Location = strcat(RegistryKey, "\\", RegistryValueName), SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // Browser extensions forced by policy, and native messaging hosts. They return through browser sync.
    (DeviceRegistryEvents | where TimeGenerated >= ago(TimeToCheck) | where ActionType in~ ("RegistryValueSet","RegistryKeyCreated") | where RegistryKey contains "ExtensionInstallForcelist" or RegistryKey contains "NativeMessagingHosts" or RegistryKey matches regex @"(?i)\\(google\\chrome|microsoft\\edge|bravesoftware\\brave-browser)\\extensions\\" | extend Method = "Browser-Extension", Actor = InitiatingProcessAccountName, Payload = RegistryValueData, Location = strcat(RegistryKey, "\\", RegistryValueName), SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // Services and tasks as the sensor recorded them, including ones created through an API.
    (DeviceEvents | where TimeGenerated >= ago(TimeToCheck) | where ActionType in~ ("ServiceInstalled") or ActionType startswith "ScheduledTask" | extend Method = "Service-Task-Installed", Actor = InitiatingProcessAccountName, Payload = strcat(ActionType, " | ", AdditionalFields, " | ", FolderPath), Location = FileName, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine)
| where DeviceName contains DeviceCheck
| where Actor contains UserIdentityCheck
| project-rename EventTime = TimeGenerated
| project EventTime, Method, DeviceName, Actor, Location, Payload, SetBy, SetByCmd
| sort by EventTime desc
//
//| where SetBy in~ (LolBins)          // only what a LOLBin created, not an installer
//| where Method in ("COM-Hijack","Shell-Hijack","Browser-Extension")  // missed by a Run-key clean-up
//| summarize Methods = make_set(Method, 10), First = min(EventTime) by DeviceName  // one line per device

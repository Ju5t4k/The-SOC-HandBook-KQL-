//Hands-on-keyboard enrichment query — ADVANCED HUNTING ONLY
//
// Runs in the Defender portal (Hunting > Advanced hunting), not in Sentinel Logs.
// FileProfile() is an Advanced Hunting function, and the time column here is Timestamp.
// Every file the device ran or wrote in the window, with Microsoft's global view of it:
// how many machines in the world have it, when the world first saw it, and who signed it.
let IncidentStart = ago(1d);              // first known attacker activity, e.g. datetime(2026-10-05T14:32:00Z)
let IncidentEnd = now();
let LookBefore = 1d;
let DeviceCheck = "";
//
let StartTime = IncidentStart - LookBefore;
let StagePaths = dynamic([@"\programdata\",@"\users\public\",@"\perflogs\",@"\windows\temp\",@"\appdata\local\temp\",@"\$recycle.bin\"]);
let ToolTypes = @"(?i)\.(exe|dll|sys|ps1|bat|cmd|vbs|js|hta|msi|jar)$";
//
union
    (DeviceProcessEvents | where Timestamp between (StartTime .. IncidentEnd) | where DeviceName contains DeviceCheck | where isnotempty(SHA1) | project SHA1, FileName, FolderPath, Seen = Timestamp, How = "executed"),
    (DeviceFileEvents | where Timestamp between (StartTime .. IncidentEnd) | where DeviceName contains DeviceCheck | where ActionType in~ ("FileCreated","FileRenamed") | where isnotempty(SHA1) and FileName matches regex ToolTypes | project SHA1, FileName, FolderPath, Seen = Timestamp, How = "written")
| summarize FirstSeen = min(Seen), LastSeen = max(Seen), Names = make_set(FileName, 5), Paths = make_set(FolderPath, 5), How = make_set(How, 2) by SHA1
| extend InStaging = tostring(Paths) has_any (StagePaths)
// FileProfile enriches the first 1,000 rows only, so put the likeliest first.
| sort by InStaging desc, FirstSeen asc
| invoke FileProfile("SHA1", 1000)
| extend RareInWorld = isnull(GlobalPrevalence) or GlobalPrevalence < 500, NewToWorld = GlobalFirstSeen > ago(30d), NotValidlySigned = SignatureState != "SignedValid"
| project RareInWorld, NewToWorld, NotValidlySigned, InStaging, GlobalPrevalence, GlobalFirstSeen, Signer, Issuer, SignatureState, ThreatName, Names, Paths, How, FirstSeen, LastSeen, SHA1, SHA256, ProfileAvailability
| sort by RareInWorld desc, NewToWorld desc, GlobalPrevalence asc
//
//| where RareInWorld and NotValidlySigned                 // unsigned and almost nowhere else on earth — read these first
//| where isnotempty(ThreatName)                          // Microsoft already has a name for it
//
// Other Advanced Hunting functions that save time on this kind of incident:
//   DeviceFromIP()          which device held an internal address at a given moment
//     DeviceLogonEvents | where Timestamp > ago(1d) | where DeviceName contains DeviceCheck | where RemoteIPType == "Private" | distinct IP = RemoteIP | invoke DeviceFromIP()
//   AssignedIPAddresses()   which addresses this device held at a given moment
//     AssignedIPAddresses("<device>", datetime(2026-10-05T14:32:00Z))
//   SeenBy()                which onboarded devices have seen an unmanaged device on the network
//     DeviceInfo | where DeviceName contains "<unmanaged device>" | invoke SeenBy()

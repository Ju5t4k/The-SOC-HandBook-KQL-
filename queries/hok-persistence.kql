//Hands-on-keyboard persistence query
//
// What an operator left so they can come back: accounts, services, tasks, autoruns,
// backdoors, remote access switched on, remote tools installed, web shells and keys.
let IncidentStart = ago(1d);              // first known attacker activity, e.g. datetime(2026-10-05T14:32:00Z)
let IncidentEnd = now();
let LookBefore = 7d;
let LookAfter = 3d;
let DeviceCheck = "";
let UserIdentityCheck = "";
//
let StartTime = IncidentStart - LookBefore;
let EndTime = IncidentEnd + LookAfter;
let RmmPattern = @"(?i)(anydesk|screenconnect|connectwise|atera|splashtop|teamviewer|rustdesk|netsupport|client32|meshagent|syncro|action1|logmein|gotoassist|supremo|ultraviewer|dwagent|tightvnc|ngrok|cloudflared)";
let AccessibilityBins = @"(?i)\\windows\\(system32|syswow64)\\(sethc|utilman|osk|narrator|magnify|displayswitch|atbroker)\.exe$";
let WebRoots = @"(?i)\\(inetpub|wwwroot|frontend\\httpproxy|webapps|htdocs|exchange server\\v\d+\\clientaccess)\\";
let WindowsUpdaters = dynamic(["TrustedInstaller.exe","TiWorker.exe","msiexec.exe","svchost.exe"]);
//
union isfuzzy=true
    // Accounts made, or added to a group. The most durable foothold there is.
    (DeviceEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType in~ ("UserAccountCreated","UserAccountAddedToLocalGroup") | extend Method = "Account", Technique = iff(ActionType =~ "UserAccountCreated", "T1136.001", "T1098"), Actor = InitiatingProcessAccountName, Location = strcat(AccountDomain, "\\", AccountName), Payload = strcat(ActionType, " | ", tostring(AdditionalFields)), SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ProcessCommandLine matches regex @"(?i)net1?(\.exe)?\s+(user|localgroup|group)\s+.*\s/add" | extend Method = "Account", Technique = "T1136.001", Actor = AccountName, Location = FileName, Payload = ProcessCommandLine, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // Services and scheduled tasks, as the sensor saw them and as they were typed.
    (DeviceEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType =~ "ServiceInstalled" or ActionType startswith "ScheduledTask" | extend Method = iff(ActionType =~ "ServiceInstalled", "Service", "Scheduled task"), Technique = iff(ActionType =~ "ServiceInstalled", "T1543.003", "T1053.005"), Actor = InitiatingProcessAccountName, Location = strcat(FolderPath, " ", FileName), Payload = strcat(ActionType, " | ", tostring(AdditionalFields)), SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ProcessCommandLine matches regex @"(?i)(sc(\.exe)?\s+(\\\\\S+\s+)?(create|config)\s|schtasks(\.exe)?\s.*/create|new-service|register-scheduledtask|new-scheduledtask)" | extend Method = iff(ProcessCommandLine has_any ("schtasks","ScheduledTask"), "Scheduled task", "Service"), Technique = iff(ProcessCommandLine has_any ("schtasks","ScheduledTask"), "T1053.005", "T1543.003"), Actor = AccountName, Location = FileName, Payload = ProcessCommandLine, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // Run keys, Winlogon and the other autostart values.
    (DeviceRegistryEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType in~ ("RegistryValueSet","RegistryKeyCreated") | where RegistryKey has_any (@"CurrentVersion\Run", @"CurrentVersion\RunOnce", @"Policies\Explorer\Run") or (RegistryKey has "Winlogon" and RegistryValueName in~ ("Userinit","Shell","Notify")) | extend Method = "Autorun", Technique = iff(RegistryKey has "Winlogon", "T1547.004", "T1547.001"), Actor = InitiatingProcessAccountName, Location = strcat(RegistryKey, "\\", RegistryValueName), Payload = RegistryValueData, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    (DeviceFileEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType in~ ("FileCreated","FileModified","FileRenamed") | where FolderPath has @"\Start Menu\Programs\Startup" | extend Method = "Autorun", Technique = "T1547.001", Actor = InitiatingProcessAccountName, Location = FolderPath, Payload = strcat("SHA256=", SHA256, " | origin=", FileOriginUrl), SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // Sticky-keys style backdoors: a debugger on an accessibility tool, or the tool itself replaced.
    // Either gives a SYSTEM shell from the logon screen with no password.
    (DeviceRegistryEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType =~ "RegistryValueSet" | where (RegistryKey has "Image File Execution Options" and RegistryValueName in~ ("Debugger","GlobalFlag")) or (RegistryKey has "SilentProcessExit" and RegistryValueName =~ "MonitorProcess") | extend Method = "Logon-screen backdoor", Technique = "T1546.012", Actor = InitiatingProcessAccountName, Location = strcat(RegistryKey, "\\", RegistryValueName), Payload = RegistryValueData, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    (DeviceFileEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType in~ ("FileCreated","FileModified","FileRenamed") | where FolderPath matches regex AccessibilityBins | where InitiatingProcessFileName !in~ (WindowsUpdaters) | extend Method = "Logon-screen backdoor", Technique = "T1546.008", Actor = InitiatingProcessAccountName, Location = FolderPath, Payload = strcat("SHA256=", SHA256, " | was ", PreviousFileName), SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // Remote access switched on: RDP allowed, network-level authentication off, RDP or WinRM opened up.
    (DeviceRegistryEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType =~ "RegistryValueSet" | where (RegistryValueName =~ "fDenyTSConnections" and RegistryValueData == "0") or (RegistryKey has @"Terminal Server\WinStations\RDP-Tcp" and RegistryValueName =~ "UserAuthentication" and RegistryValueData == "0") or (RegistryKey has @"Terminal Server\WinStations\RDP-Tcp" and RegistryValueName =~ "PortNumber") | extend Method = "Remote access enabled", Technique = "T1021.001", Actor = InitiatingProcessAccountName, Location = strcat(RegistryKey, "\\", RegistryValueName), Payload = RegistryValueData, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ProcessCommandLine matches regex @"(?i)(enable-psremoting|winrm(\.cmd)?\s+(quickconfig|qc)|advfirewall\s+firewall\s+(add|set)\s+rule.*(3389|5985|5986|remote desktop)|set-itemproperty.*fdenytsconnections)" | extend Method = "Remote access enabled", Technique = iff(ProcessCommandLine has_any ("winrm","PSRemoting","5985","5986"), "T1021.006", "T1021.001"), Actor = AccountName, Location = FileName, Payload = ProcessCommandLine, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // A remote support tool installed to stay: as a service, or into Program Files.
    (DeviceEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType =~ "ServiceInstalled" | where tostring(AdditionalFields) matches regex RmmPattern or FolderPath matches regex RmmPattern or FileName matches regex RmmPattern | extend Method = "Remote access tool", Technique = "T1219", Actor = InitiatingProcessAccountName, Location = strcat(FolderPath, " ", FileName), Payload = tostring(AdditionalFields), SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    (DeviceFileEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType in~ ("FileCreated","FileRenamed") | where FileName endswith ".exe" and (FileName matches regex RmmPattern or FolderPath matches regex RmmPattern) | extend Method = "Remote access tool", Technique = "T1219", Actor = InitiatingProcessAccountName, Location = FolderPath, Payload = strcat("SHA256=", SHA256, " | origin=", FileOriginUrl), SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // WMI event subscriptions: code that runs when something happens, with nothing on disk to find.
    (DeviceEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType =~ "WmiBindEventFilterToConsumer" | extend Method = "WMI subscription", Technique = "T1546.003", Actor = InitiatingProcessAccountName, Location = ActionType, Payload = tostring(AdditionalFields), SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ProcessCommandLine has_any ("__EventFilter","CommandLineEventConsumer","ActiveScriptEventConsumer","__FilterToConsumerBinding","Register-WmiEvent","Set-WmiInstance") | extend Method = "WMI subscription", Technique = "T1546.003", Actor = AccountName, Location = FileName, Payload = ProcessCommandLine, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // Code loaded into LSASS or netsh. Survives reboots and sees every password typed.
    (DeviceRegistryEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType =~ "RegistryValueSet" | where (RegistryKey has @"Control\Lsa" and RegistryValueName in~ ("Authentication Packages","Security Packages","Notification Packages")) or RegistryKey has @"Microsoft\NetSh" | extend Method = iff(RegistryKey has "NetSh", "Netsh helper", "LSA package"), Technique = case(RegistryKey has "NetSh", "T1546.007", RegistryValueName =~ "Notification Packages", "T1556.002", "T1547.002"), Actor = InitiatingProcessAccountName, Location = strcat(RegistryKey, "\\", RegistryValueName), Payload = RegistryValueData, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // User-hive COM hijacks and forced browser extensions.
    (DeviceRegistryEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType in~ ("RegistryValueSet","RegistryKeyCreated") | where (RegistryKey has @"Classes\CLSID" and RegistryKey has_any ("InprocServer32","LocalServer32","TreatAs")) or RegistryKey has "ExtensionInstallForcelist" | extend Method = iff(RegistryKey has "ExtensionInstallForcelist", "Browser extension", "COM hijack"), Technique = iff(RegistryKey has "ExtensionInstallForcelist", "T1176", "T1546.015"), Actor = InitiatingProcessAccountName, Location = strcat(RegistryKey, "\\", RegistryValueName), Payload = RegistryValueData, SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // Web shells: script files written into a web root. The way back in on an exposed server.
    (DeviceFileEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType in~ ("FileCreated","FileModified","FileRenamed") | where FileName matches regex @"(?i)\.(aspx|ashx|asmx|asp|jsp|jspx|php|cfm)$" | where FolderPath matches regex WebRoots | extend Method = "Web shell", Technique = "T1505.003", Actor = InitiatingProcessAccountName, Location = FolderPath, Payload = strcat("SHA256=", SHA256), SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine),
    // SSH keys planted for the operator's own key.
    (DeviceFileEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType in~ ("FileCreated","FileModified") | where FileName in~ ("authorized_keys","administrators_authorized_keys","authorized_keys2") | extend Method = "SSH key", Technique = "T1098.004", Actor = InitiatingProcessAccountName, Location = FolderPath, Payload = strcat("SHA256=", SHA256), SetBy = InitiatingProcessFileName, SetByCmd = InitiatingProcessCommandLine)
| where Actor contains UserIdentityCheck
| extend Window = case(TimeGenerated < IncidentStart, "1-Before", TimeGenerated <= IncidentEnd, "2-During", "3-After")
| project-rename EventTime = TimeGenerated
| project EventTime, Window, Method, Technique, DeviceName, Actor, Location, Payload, SetBy, SetByCmd
| sort by EventTime asc
//
//| where Window != "1-Before"                        // what changed once they were in
//| where Method in ("Account","Logon-screen backdoor","Remote access enabled","Web shell","SSH key")  // ways back in that need no malware at all
//| summarize Methods = make_set(Method, 15), First = min(EventTime) by DeviceName  // one line per device — the eviction checklist

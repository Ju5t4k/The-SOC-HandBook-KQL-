// #############################################################################
// SIGNINLOGS
//
// Entra ID interactive sign-ins. The first table in almost every investigation,
// because almost every investigation starts with "was this account used, and by
// whom".
//
// HOW THESE QUERIES WORK
//   Every query in this repo has the same shape:
//
//     1. A FILL-IN block of `let` statements at the very top. Put your
//        identifier in one of them and run. Leave them all blank and you get
//        the whole tenant.
//     2. A stack of CONTEXT `let` blocks that pre-aggregate the answers to the
//        questions you were going to ask next — how new is this IP, who else
//        uses it, what is this person's job, how many days has this device been
//        seen.
//     3. The main table, filtered, with all of that joined onto every row.
//
//   The filters use `contains`, which is a case-insensitive substring match, so
//   a partial value works: "jane" matches jane.doe@contoso.com. `contains ""`
//   is true for every row, which is why a blank means "no filter". If you want
//   an exact match instead, swap `contains` for `=~`.
//
// COST WARNING
//   With every CHECK left blank these queries read the whole tenant and join it
//   to itself ten times. That is fine on a small workspace and expensive on a
//   large one. Fill in at least one identifier, or drop TimeToCheck to 24h,
//   before running one blank on a big tenant.
//
// PLATFORM
//   Written for Microsoft Sentinel (`TimeGenerated`). In Defender Advanced
//   Hunting the equivalent table is `AADSignInEventsBeta` and the time column
//   is `Timestamp`.
// #############################################################################


// -----------------------------------------------------------------------------
// QUERY:    SigninLogs — full sign-in investigation
// VERSION:  2026.09.02
// TABLES:   SigninLogs, IdentityInfo, AuditLogs
// ATT&CK:   T1078 Valid Accounts, T1078.004 Cloud Accounts
//
// FILL IN:
//   Any one of UserIdentityCheck, IPtoCheck, DeviceToCheck, AppToCheck or
//   LocationToCheck. Combine them to narrow further — an account AND an
//   address answers "what did this person do from here".
//
// WHAT YOU GET:
//   Every sign-in for the target, with each row carrying the answers to the
//   follow-up questions:
//     JobDetails             who the account belongs to, their manager, roles,
//                            whether it is still enabled
//     AccountCreated         when the account was created, if it was created
//                            inside the baseline window — a new starter behaves
//                            unlike a compromised long-standing account
//     DaysIPSeenInOrg        how many days this address has appeared anywhere
//                            in the tenant
//     DaysIPSeenByUser       how many days it has appeared for THIS account
//     UsersOnThisIP          how many accounts have used it
//     UsersWithThisIP        which ones
//     DaysDeviceSeenByUser   device, user agent, location and application, each
//     DaysAgentSeenByUser    scored the same way: how many days of the baseline
//     DaysLocationSeenByUser has this account used it
//     DaysAppSeenByUser
//     EventsInSession        how many rows share this CorrelationId
//
// HOW TO READ IT:
//   The day-counts are the verdict. A sign-in where the IP, the device, the
//   location and the user agent are ALL first-day-seen is a different account
//   from the one that signed in yesterday. One new dimension is a new phone or
//   a holiday; four at once is someone else.
//   DaysIPSeenInOrg high but DaysIPSeenByUser 1 means the address is normal for
//   the company and new for this person — usually an office they do not work
//   from, sometimes a proxy the attacker also picked.
//   DaysIPSeenInOrg 1 with UsersOnThisIP high is the opposite and much worse:
//   a brand-new address that many accounts suddenly share.
//   ResultType is a STRING. "0" is success.
//
// MODIFY IT:
//   - Leave every CHECK blank and set TimeToCheck to 1h for a live tenant-wide
//     view — useful during an incident, expensive otherwise.
//   - Swap `contains` for `=~` on UserPrincipalName for an exact match when the
//     username is a substring of other usernames.
//   - Add `| where ResultType == "0"` to see only what actually worked.
//   - Add `| where DaysIPSeenByUser <= 1 and DaysDeviceSeenByUser <= 1` to jump
//     straight to the sign-ins where both the address and the device are new.
//   - Raise BaselineToCheck to 180d to make "new" mean genuinely new. Note that
//     SigninLogs retention is usually 30-90d, so the baseline silently
//     truncates to whatever you actually keep.
//   - Change the IPUsers block to `ResultType != "0"` to list the accounts an
//     address has FAILED against rather than succeeded — that is the spray view.
// -----------------------------------------------------------------------------
// ===== FILL IN — leave blank for "everything" ================================
let TimeToCheck       = 30d;   // the window you are investigating
let BaselineToCheck   = 90d;   // how far back "normal" is measured
let UserIdentityCheck = "";    // UPN or part of one, e.g. "jane.doe"
let IPtoCheck         = "";    // address or prefix, e.g. "203.0.113."
let DeviceToCheck     = "";    // device id, name, browser or OS
let AppToCheck        = "";    // application display name
let LocationToCheck   = "";    // country, state or city
// =============================================================================

// --- CONTEXT: who does this account belong to? (needs UEBA or MDI) -----------
let Job = IdentityInfo
    | where TimeGenerated > ago(BaselineToCheck)
    | where AccountUPN contains UserIdentityCheck
    | summarize arg_max(TimeGenerated, *) by AccountObjectId
    | extend JobDetails = bag_pack(
          "1.JobTitle",   JobTitle,
          "2.Department", Department,
          "3.Manager",    tostring(Manager),
          "4.RiskLevel",  RiskLevel,
          "5.Roles",      tostring(AssignedRoles),
          "6.Enabled",    IsAccountEnabled,
          "7.UserType",   UserType)
    | project JobUserKey = tolower(AccountUPN), JobDetails;

// --- CONTEXT: was this account created recently? -----------------------------
// TargetResources is a dynamic array, so expand it rather than string-matching
// the raw JSON — string matching finds the right event but the wrong field.
let NewStarter = AuditLogs
    | where TimeGenerated > ago(BaselineToCheck)
    | where OperationName == "Add user"
    | mv-expand TargetResources
    | extend NewUserUpn = tolower(tostring(TargetResources.userPrincipalName))
    | where isnotempty(NewUserUpn) and NewUserUpn contains tolower(UserIdentityCheck)
    | summarize AccountCreated = min(TimeGenerated) by NsUserKey = NewUserUpn;

// --- CONTEXT: how well known is this address, tenant-wide? --------------------
// dcount(bin(TimeGenerated, 1d)) counts DAYS. Counting datetime_part("day", ...)
// counts day-of-month and silently caps at 31 — a common and quiet mistake.
let IPDaysOrg = SigninLogs
    | where TimeGenerated > ago(BaselineToCheck)
    | summarize DaysIPSeenInOrg = dcount(bin(TimeGenerated, 1d)),
                UsersOnThisIP   = dcount(UserPrincipalName)
            by OrgIP = IPAddress;

// --- CONTEXT: how well known is this address to THIS account? -----------------
let IPDaysUser = SigninLogs
    | where TimeGenerated > ago(BaselineToCheck)
    | where UserPrincipalName contains UserIdentityCheck
    | summarize DaysIPSeenByUser  = dcount(bin(TimeGenerated, 1d)),
                FirstIPSeenByUser = min(TimeGenerated)
            by UserIP = IPAddress;

// --- CONTEXT: who else signs in successfully from it? ------------------------
let IPUsers = SigninLogs
    | where TimeGenerated > ago(TimeToCheck)
    | where ResultType == "0"
    | summarize UsersWithThisIP = make_set(UserPrincipalName, 25) by SetIP = IPAddress;

// --- CONTEXT: how big is the sign-in session this row belongs to? ------------
let SessionSize = SigninLogs
    | where TimeGenerated > ago(TimeToCheck)
    | summarize EventsInSession = count() by SessionCorrelationId = CorrelationId;

// --- CONTEXT: device, agent, location and app familiarity for this account ---
let DeviceDays = SigninLogs
    | where TimeGenerated > ago(BaselineToCheck)
    | where UserPrincipalName contains UserIdentityCheck
    | extend DdDeviceKey = tostring(DeviceDetail.deviceId)
    | where isnotempty(DdDeviceKey)
    | summarize DaysDeviceSeenByUser = dcount(bin(TimeGenerated, 1d)) by DdDeviceKey;

let AgentDays = SigninLogs
    | where TimeGenerated > ago(BaselineToCheck)
    | where UserPrincipalName contains UserIdentityCheck
    | where isnotempty(UserAgent)
    | summarize DaysAgentSeenByUser = dcount(bin(TimeGenerated, 1d)) by AdUserAgent = UserAgent;

let LocationDays = SigninLogs
    | where TimeGenerated > ago(BaselineToCheck)
    | where UserPrincipalName contains UserIdentityCheck
    | extend LdLocationKey = strcat(tostring(LocationDetails.countryOrRegion), " / ",
                                    tostring(LocationDetails.state), " / ",
                                    tostring(LocationDetails.city))
    | summarize DaysLocationSeenByUser = dcount(bin(TimeGenerated, 1d)) by LdLocationKey;

let AppDays = SigninLogs
    | where TimeGenerated > ago(BaselineToCheck)
    | where UserPrincipalName contains UserIdentityCheck
    | summarize DaysAppSeenByUser = dcount(bin(TimeGenerated, 1d)) by ApAppDisplayName = AppDisplayName;

// --- MAIN --------------------------------------------------------------------
SigninLogs
| where TimeGenerated > ago(TimeToCheck)
| where UserPrincipalName contains UserIdentityCheck
| where IPAddress contains IPtoCheck
| where AppDisplayName contains AppToCheck
// Flatten the two dynamic columns once, up front — every filter and join below
// uses these rather than re-parsing the JSON.
| extend DeviceKey    = tostring(DeviceDetail.deviceId),
         DeviceName   = tostring(DeviceDetail.displayName),
         Browser      = tostring(DeviceDetail.browser),
         OperatingSys = tostring(DeviceDetail.operatingSystem),
         IsCompliant  = tostring(DeviceDetail.isCompliant),
         IsManaged    = tostring(DeviceDetail.isManaged),
         Country      = tostring(LocationDetails.countryOrRegion),
         State        = tostring(LocationDetails.state),
         City         = tostring(LocationDetails.city)
| extend DeviceSummary = strcat(DeviceKey, " ", DeviceName, " ", Browser, " ", OperatingSys),
         LocationKey   = strcat(Country, " / ", State, " / ", City)
| where DeviceSummary contains DeviceToCheck
| where LocationKey contains LocationToCheck
| extend UserKey = tolower(UserPrincipalName)
// Each context block is keyed on a differently-named column so the joins do not
// produce IPAddress1 / IPAddress2 and leave you guessing which is which.
| join kind=leftouter Job          on $left.UserKey       == $right.JobUserKey
| join kind=leftouter NewStarter   on $left.UserKey       == $right.NsUserKey
| join kind=leftouter IPDaysOrg    on $left.IPAddress     == $right.OrgIP
| join kind=leftouter IPDaysUser   on $left.IPAddress     == $right.UserIP
| join kind=leftouter IPUsers      on $left.IPAddress     == $right.SetIP
| join kind=leftouter SessionSize  on $left.CorrelationId == $right.SessionCorrelationId
| join kind=leftouter DeviceDays   on $left.DeviceKey     == $right.DdDeviceKey
| join kind=leftouter AgentDays    on $left.UserAgent     == $right.AdUserAgent
| join kind=leftouter LocationDays on $left.LocationKey   == $right.LdLocationKey
| join kind=leftouter AppDays      on $left.AppDisplayName == $right.ApAppDisplayName
// How many dimensions of this sign-in are new to the account: 0 is routine,
// 4 is a different person. Booleans do not add in KQL, hence toint().
| extend NewToUser = toint(coalesce(DaysIPSeenByUser, 0) <= 1)
                   + toint(coalesce(DaysDeviceSeenByUser, 0) <= 1)
                   + toint(coalesce(DaysLocationSeenByUser, 0) <= 1)
                   + toint(coalesce(DaysAgentSeenByUser, 0) <= 1)
// project-reorder rather than project: the useful columns come first, but every
// other column SigninLogs carries is still there when you need it.
| project-reorder TimeGenerated, UserPrincipalName, UserDisplayName, JobDetails,
                  AccountCreated, NewToUser,
                  ResultType, ResultDescription,
                  IPAddress, DaysIPSeenByUser, DaysIPSeenInOrg, UsersOnThisIP,
                  UsersWithThisIP, FirstIPSeenByUser,
                  LocationKey, DaysLocationSeenByUser,
                  DeviceName, DeviceKey, DaysDeviceSeenByUser, IsCompliant, IsManaged,
                  Browser, OperatingSys, UserAgent, DaysAgentSeenByUser,
                  AppDisplayName, DaysAppSeenByUser, ResourceDisplayName,
                  AuthenticationRequirement, ConditionalAccessStatus,
                  RiskLevelDuringSignIn, RiskState, RiskDetail,
                  EventsInSession, CorrelationId
| project-away JobUserKey, NsUserKey, OrgIP, UserIP, SetIP, SessionCorrelationId,
               DdDeviceKey, AdUserAgent, LdLocationKey, ApAppDisplayName,
               DeviceSummary, UserKey
| sort by TimeGenerated desc


// -----------------------------------------------------------------------------
// QUERY:    SigninLogs — failure analysis, spray and brute force
// VERSION:  2026.09.02
// TABLES:   SigninLogs, IdentityInfo
// ATT&CK:   T1110 Brute Force, T1110.003 Password Spraying, T1621 MFA Request
//           Generation
//
// FILL IN:
//   Nothing, to sweep the tenant for spray sources. Or IPtoCheck to profile one
//   address, or UserIdentityCheck to see what is being thrown at one account.
//
// WHAT YOU GET:
//   One row per source address per application per time bucket, with the
//   failure reasons decoded into English, the accounts targeted, and — the
//   column that decides your verdict — whether anything SUCCEEDED.
//
// HOW TO READ IT:
//   Successes is the only number that turns this from noise into an incident.
//   Everything else tells you what kind of noise it is:
//     many users, few attempts each, one app   = password spray
//     one user, many attempts                  = brute force
//     50126 only                               = guessing passwords
//     50126 then 50053                         = guessing until lockout
//     500121 repeated                          = MFA fatigue, password already
//                                                known — treat as compromise
//     50158 / 53003                            = Conditional Access held
//   DaysIPSeenInOrg near zero on a high-volume source is an outside attacker.
//   A high day-count is usually your own VPN or a broken service account.
//
// MODIFY IT:
//   - Set Bucket to 1d and TimeToCheck to 30d for a slow-and-low spray that
//     stays under any hourly threshold.
//   - Add `| where Successes > 0` for the incident list only.
//   - Change `by` from IPAddress to UserPrincipalName to flip the question from
//     "which sources are attacking" to "which accounts are under attack".
//   - Add `| where FailureCodes has "500121"` for the MFA-fatigue view alone.
//   - Drop MinAttempts to 1 when investigating one named address, where volume
//     no longer matters.
// -----------------------------------------------------------------------------
// ===== FILL IN — leave blank for "everything" ================================
let TimeToCheck       = 24h;
let BaselineToCheck   = 90d;
let UserIdentityCheck = "";
let IPtoCheck         = "";
let AppToCheck        = "";
let Bucket            = 1h;    // the window failures are grouped into
let MinAttempts       = 10;    // ignore sources quieter than this
// =============================================================================

// --- CONTEXT: how well known is the source address? --------------------------
let IPDaysOrg = SigninLogs
    | where TimeGenerated > ago(BaselineToCheck)
    | summarize DaysIPSeenInOrg = dcount(bin(TimeGenerated, 1d)) by OrgIP = IPAddress;

// --- CONTEXT: which of the targeted accounts are privileged? -----------------
// Materialised into an array with toscalar: a tabular `let` can be used with
// `in` inside a `where`, but not inside an aggregate's predicate.
let Privileged = toscalar(
    IdentityInfo
    | where TimeGenerated > ago(BaselineToCheck)
    | summarize arg_max(TimeGenerated, *) by AccountObjectId
    | where array_length(todynamic(AssignedRoles)) > 0
    | summarize make_set(tolower(AccountUPN), 10000));

SigninLogs
| where TimeGenerated > ago(TimeToCheck)
| where UserPrincipalName contains UserIdentityCheck
| where IPAddress contains IPtoCheck
| where AppDisplayName contains AppToCheck
| extend Country = tostring(LocationDetails.countryOrRegion)
| extend FailureReason = case(
      ResultType == "0",      "0 success",
      ResultType == "50126",  "50126 wrong username or password",
      ResultType == "50053",  "50053 account locked / smart lockout",
      ResultType == "50055",  "50055 password expired",
      ResultType == "50056",  "50056 invalid or null password",
      ResultType == "50057",  "50057 account disabled",
      ResultType == "50058",  "50058 silent sign-in failed, no session",
      ResultType == "50074",  "50074 strong auth required",
      ResultType == "50076",  "50076 MFA required by policy",
      ResultType == "50079",  "50079 user must enrol MFA",
      ResultType == "50105",  "50105 not assigned to the application",
      ResultType == "50133",  "50133 session invalid, password changed",
      ResultType == "50158",  "50158 external security challenge not satisfied",
      ResultType == "500121", "500121 MFA denied or timed out by the user",
      ResultType == "53003",  "53003 blocked by Conditional Access",
      ResultType == "53004",  "53004 must enrol MFA to continue",
      ResultType == "65001",  "65001 no consent for the application",
      ResultType == "70043",  "70043 refresh token expired",
      ResultType == "530032", "530032 blocked by a security policy",
      strcat(ResultType, " see aka.ms/aadsterrors"))
| extend UserKey = tolower(UserPrincipalName)
| extend IsPrivileged = set_has_element(Privileged, UserKey)
| summarize Attempts        = count(),
            Successes       = countif(ResultType == "0"),
            Failures        = countif(ResultType != "0"),
            TargetedUsers   = dcount(UserPrincipalName),
            SucceededUsers  = dcountif(UserPrincipalName, ResultType == "0"),
            UserList        = make_set(UserPrincipalName, 40),
            SucceededList   = make_set_if(UserPrincipalName, ResultType == "0", 20),
            PrivilegedHit   = make_set_if(UserPrincipalName, IsPrivileged, 20),
            FailureCodes    = make_set(ResultType, 12),
            FailureReasons  = make_set(FailureReason, 12),
            Countries       = make_set(Country, 8),
            UserAgents      = make_set(UserAgent, 8),
            FirstSeen       = min(TimeGenerated),
            LastSeen        = max(TimeGenerated)
        by IPAddress, AppDisplayName, TimeBucket = bin(TimeGenerated, Bucket)
| where Attempts >= MinAttempts
| join kind=leftouter IPDaysOrg on $left.IPAddress == $right.OrgIP
| extend UsersPerAttempt = round(todouble(TargetedUsers) / todouble(Attempts), 2)
| project-reorder TimeBucket, IPAddress, DaysIPSeenInOrg, Countries,
                  Successes, SucceededUsers, SucceededList, PrivilegedHit,
                  Failures, Attempts, TargetedUsers, UsersPerAttempt,
                  FailureReasons, FailureCodes, AppDisplayName, UserList,
                  UserAgents, FirstSeen, LastSeen
| project-away OrgIP
| sort by Successes desc, Attempts desc


// -----------------------------------------------------------------------------
// QUERY:    Token and service principal sign-ins the interactive table hides
// VERSION:  2026.09.02
// TABLES:   AADNonInteractiveUserSignInLogs, AADServicePrincipalSignInLogs,
//           SigninLogs
// ATT&CK:   T1550.001 Application Access Token, T1528 Steal Application Access
//           Token
//
// FILL IN:
//   UserIdentityCheck, or IPtoCheck. Run it for every account you have just
//   investigated in the query above.
//
// WHAT YOU GET:
//   The three sign-in tables unioned into one timeline, each row tagged with
//   which table it came from, and each address scored against what that account
//   has used INTERACTIVELY. An attacker holding a stolen refresh token or
//   session cookie never appears in SigninLogs again — they appear here.
//
// HOW TO READ IT:
//   SeenInteractively = 0 is the column that matters. A token being used from
//   an address the account has never interactively signed in from is the
//   signature of token theft, and it is invisible if you only read SigninLogs.
//   ServicePrincipal rows have no user at all — for those, an address the app
//   has not used before is the equivalent signal.
//
// MODIFY IT:
//   - Add `| where SeenInteractively == 0` to cut straight to the finding.
//   - Remove the AADServicePrincipalSignInLogs leg if you only care about users.
//   - Change `Source` grouping to summarize by IPAddress to get a source-address
//     view rather than a timeline.
//   - Pair with the AuditLogs investigation query on the same account and window
//     — a token used from a new address, then a credential change, is the whole
//     incident in two queries.
// -----------------------------------------------------------------------------
// ===== FILL IN — leave blank for "everything" ================================
let TimeToCheck       = 7d;
let BaselineToCheck   = 30d;
let UserIdentityCheck = "";
let IPtoCheck         = "";
let AppToCheck        = "";
// =============================================================================

// --- CONTEXT: addresses this account has used INTERACTIVELY ------------------
let InteractiveIPs = SigninLogs
    | where TimeGenerated > ago(BaselineToCheck)
    | where UserPrincipalName contains UserIdentityCheck
    | where ResultType == "0"
    | summarize SeenInteractively = dcount(bin(TimeGenerated, 1d)) by IntIP = IPAddress;

union isfuzzy=true
    (
    SigninLogs
    | where TimeGenerated > ago(TimeToCheck)
    | where UserPrincipalName contains UserIdentityCheck
    | extend Source = "1-Interactive", Actor = UserPrincipalName
    ),
    (
    AADNonInteractiveUserSignInLogs
    | where TimeGenerated > ago(TimeToCheck)
    | where UserPrincipalName contains UserIdentityCheck
    | extend Source = "2-NonInteractive", Actor = UserPrincipalName
    ),
    (
    AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(TimeToCheck)
    | extend Source = "3-ServicePrincipal", Actor = ServicePrincipalName
    )
| where IPAddress contains IPtoCheck
| where AppDisplayName contains AppToCheck
| join kind=leftouter InteractiveIPs on $left.IPAddress == $right.IntIP
| extend SeenInteractively = coalesce(SeenInteractively, 0)
| extend Country = tostring(LocationDetails.countryOrRegion)
| project-reorder TimeGenerated, Source, Actor, SeenInteractively,
                  ResultType, ResultDescription, IPAddress, Country,
                  AppDisplayName, ResourceDisplayName, ServicePrincipalName,
                  ServicePrincipalId, UserAgent, CorrelationId
| project-away IntIP
| sort by TimeGenerated desc

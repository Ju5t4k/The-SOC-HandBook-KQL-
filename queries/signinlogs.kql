//SigninLogs UserPrincipal query/v20251217
//
// Sign-in investigation for a user, IP or device. Fill in any of the CHECK
// values below and run; leave them blank and it returns everything.
//
// The filters use `contains`, so a partial value works ("jane" matches
// jane.doe@contoso.com) and an empty string matches every row — which is why
// blank means "no filter".
//
// Each `let` block below answers one question about the sign-in and is joined
// onto every row: who the account belongs to, whether they are a new starter,
// how many days the IP / device / location / user agent / app has been seen,
// and which other accounts share the address.
//
let TimeToCheck = 30d;
let UserIdentityCheck = "";
let IPtoCheck = "";
let DeviceDetailtoCheck = "";
//
let Job = IdentityInfo | where AccountUPN contains UserIdentityCheck | where TimeGenerated >=ago(90d) | extend AccountUPN = tolower(AccountUPN)| summarize arg_max(TimeGenerated, *) by AccountObjectId | extend JobDetails = bag_pack("0.Job", JobTitle, "1.RiskLevel", RiskLevel, "2.AssignedRoles", AssignedRoles, "3.Manager", Manager) | project JobDetails, AccountUPN;
let NewStarterCheck = AuditLogs | where TargetResources contains UserIdentityCheck | where TimeGenerated >ago(90d) | where OperationName == "Add user" | where TargetResources contains "AccountEnabled" | extend PropertiesString = tostring(TargetResources) | extend JobString = extract('"JobTitle.*?"', 0, PropertiesString) | extend JobTitle = extract('"newValue":"\\[\\"(.*?)\\\\"\\]"', 1, JobString) | extend UserString = extract('"DisplayName.*?"', 0, PropertiesString) | extend Identity = extract('"newValue":"\\[\\"(.*?)\\\\"\\]"', 1, UserString) | project-rename StartDate = ActivityDateTime | project StartDate, JobTitle, Identity;
let allIPcounts = SigninLogs | where TimeGenerated >= ago(TimeToCheck) | summarize DaysIpSeenInOrg = dcount(datetime_part("day", TimeGenerated)) by IPAddress;
let uniqueCounts = SigninLogs | where UserPrincipalName contains UserIdentityCheck | where TimeGenerated >= ago(TimeToCheck) | summarize DaysIpSeenByUser = dcount(datetime_part("day", TimeGenerated)) by IPAddress;
let UniqueCorrelatedIDs = SigninLogs | where TimeGenerated >= ago(TimeToCheck) | summarize UniqueEvents = dcount(CorrelationId) by CorrelationId;
let DistinctIDfromIP = SigninLogs | where TimeGenerated >= ago(TimeToCheck) | where ResultType == "0" | summarize UsersWithThisIP = make_set(Identity) by IPAddress;
let DeviceCount = SigninLogs | where UserPrincipalName contains UserIdentityCheck | where TimeGenerated >= ago(TimeToCheck) | extend DeviceString = tostring(DeviceDetail) | extend DeviceShort = extract(@"deviceId.*?browser.*?(\w+)", 0, DeviceString) | where isnotempty( DeviceShort) | summarize DeviceDayCount = dcount(datetime_part("day", TimeGenerated)) by DeviceShort;
let UserAgentCount = SigninLogs | where UserPrincipalName contains UserIdentityCheck | where TimeGenerated >= ago(TimeToCheck) | summarize UserAgentDayCount = dcount(datetime_part("day", TimeGenerated)) by UserAgent;
let LocationCount = SigninLogs | where UserPrincipalName contains UserIdentityCheck | where TimeGenerated >= ago(TimeToCheck) | extend LocationString = tostring(LocationDetails) | extend LocationShort = extract(@"([^,]*),([^,]*),([^,]*)",1, LocationString) | summarize DaysLocationSeenUser = dcount(datetime_part("day", TimeGenerated)) by LocationShort;
let AppDisplayNameCount = SigninLogs | where UserPrincipalName contains UserIdentityCheck | where TimeGenerated >= ago(TimeToCheck) | summarize AppDayCount = dcount(datetime_part("day", TimeGenerated)) by AppDisplayName;
//
SigninLogs
| where TimeGenerated >= ago(TimeToCheck)
| extend DeviceString = tostring(DeviceDetail) | extend LocationString = tostring(LocationDetails) | extend DeviceShort = extract(@"deviceId.*?browser.*?(\w+)", 0, DeviceString)
| extend LocationString = tostring(LocationDetails) | extend LocationShort = extract(@"([^,]*),([^,]*),([^,]*)",1, LocationString)
| join kind=fullouter NewStarterCheck on Identity | join kind=inner (allIPcounts) on IPAddress | join kind=inner (uniqueCounts) on IPAddress | join kind=leftouter (DistinctIDfromIP) on IPAddress
| join kind=inner (UniqueCorrelatedIDs) on CorrelationId | join kind=leftouter (DeviceCount) on DeviceShort | join kind=inner (UserAgentCount) on UserAgent | join kind=inner (LocationCount) on LocationShort | join kind=inner (AppDisplayNameCount) on AppDisplayName | join kind=leftouter Job on $left.UserPrincipalName == $right.AccountUPN
| where UserPrincipalName contains UserIdentityCheck | where DeviceDetail contains DeviceDetailtoCheck | where IPAddress contains IPtoCheck
| extend UsersWIPCount = array_length(UsersWithThisIP)
| project-rename LogCreatedTime = TimeGenerated, EventTime = CreatedDateTime
//| where CorrelationId in (UniqueCorrelatedIDs) | summarize arg_max(EventTime, *) by CorrelationId
| project-reorder EventTime, LogCreatedTime, RiskDetail, RiskEventTypes, UsersWIPCount, UsersWithThisIP, StartDate, JobTitle, identity, JobDetails, IPAddress, DaysIpSeenInOrg, DaysIpSeenByUser, ResultType, ResultDescription, AppDayCount, AppDisplayName, DaysLocationSeenUser, LocationShort, AuthenticationDetails, DeviceDayCount, DeviceDetail, DeviceShort, UserAgentDayCount, UserAgent, MfaDetail, ConditionalAccessPolicies, ConditionalAccessStatus, CorrelationId
| project-away TenantId, SourceSystem, Resource*, Operation*, Category, ResultSignature, DurationMs, Level, Location, AppId, AuthenticationContextClassReferences, AuthenticationProcessingDetails, AuthenticationRe*, ClientAppUsed, IsInteractive, Id, LocationDetails, NetworkLocationDetails, OriginalRequestId, ProcessingTimeInMilliseconds, RiskEventTypes_V2, RiskLevelAggregated, RiskLevelDuringSignIn, RiskState, Status, Token*, UserDisplayName, AADTenantId, UserType, HomeTenantId, UniqueTokenIdentifier, SessionLifetimePolicies, AutonomousSystemNumber, AuthenticationProtocol, Type, DeviceString, LocationString, Identity1, IPAddress1, IPAddress2, IPAddress3, CorrelationId1, UniqueEvents, UserAgent1, LocationShort1, AppDisplayName1, AlternateSignInName, SignInIdentifier, CrossTenantAccessType, ClientCredentialType, IsThroughGlobalSecureAccess, OriginalTransferMethod, IsTenantRestricted, UserId, IncomingTokenType, DeviceShort*
| sort by EventTime desc
//| extend DeviceString = tostring(DeviceDetail) | where DeviceDetail !contains ""

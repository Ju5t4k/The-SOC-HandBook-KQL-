//DeviceCode timeline query
//
// Set PivotTime to the device code sign-in time (EventTime from devicecode.kql).
let PivotTime = now();
let BeforeWindow = 4h;
let AfterWindow = 48h;
let UserIdentityCheck = "";
//
let StartTime = PivotTime - BeforeWindow;
let EndTime = PivotTime + AfterWindow;
//
union isfuzzy=true
    // PHASE 1 — code delivery. Mail or Teams asking the user to enter a code.
    (OfficeActivity | where TimeGenerated between (StartTime .. EndTime) | where OfficeWorkload in~ ("Exchange","MicrosoftTeams") | where Operation has_any ("MailItemsAccessed","Send","MessageSent","ChatCreated","MemberAdded") | extend Phase = "1-Delivery", Source = "OfficeActivity", Actor = UserId, Detail = strcat(OfficeWorkload, " | ", Operation, " | ", ResultStatus, " | ", ClientIP)),
    // PHASE 2 — code entry. The sign-in looks perfect: real user, real MFA,
    // real address. Do not read the absence of an error as evidence.
    (SigninLogs | where TimeGenerated between (StartTime .. EndTime) | where AuthenticationProtocol =~ "deviceCode" or OriginalTransferMethod =~ "deviceCodeFlow" | extend Phase = "2-Code entry", Source = "SigninLogs", Actor = UserPrincipalName, Detail = strcat("deviceCode ", ResultType, " ", ResultDescription, " | ", AppDisplayName, " -> ", ResourceDisplayName, " | ", IPAddress, " ASN=", AutonomousSystemNumber, " | ", tostring(LocationDetails.countryOrRegion), " | MFA=", AuthenticationRequirement, " | CA=", ConditionalAccessStatus)),
    // PHASE 3 — the user's other interactive sign-ins in the window.
    (SigninLogs | where TimeGenerated between (StartTime .. EndTime) | where AuthenticationProtocol !~ "deviceCode" | extend Phase = "3-Sign-ins", Source = "SigninLogs", Actor = UserPrincipalName, Detail = strcat("sign-in ", ResultType, " | ", AppDisplayName, " | ", IPAddress, " ASN=", AutonomousSystemNumber, " | ", tostring(LocationDetails.countryOrRegion), " | ", ClientAppUsed)),
    // PHASE 4 — token use. The attacker shows here: same identity, different network.
    (AADNonInteractiveUserSignInLogs | where TimeGenerated between (StartTime .. EndTime) | extend Phase = "4-Token use", Source = "NonInteractive", Actor = UserPrincipalName, Detail = strcat(SignInEventTypes, " ", ResultType, " | ", AppDisplayName, " -> ", ResourceDisplayName, " | ", IPAddress, " ASN=", AutonomousSystemNumber, " | ", tostring(todynamic(LocationDetails).countryOrRegion), " | token=", IncomingTokenType)),
    // PHASE 5 — service principals. App consent grants access without the user.
    (AADServicePrincipalSignInLogs | where TimeGenerated between (StartTime .. EndTime) | extend Phase = "5-Service principal", Source = "ServicePrincipal", Actor = ServicePrincipalName, Detail = strcat(ResultType, " | ", AppId, " -> ", ResourceDisplayName, " | ", IPAddress)),
    // PHASE 6 — directory persistence. MFA methods, consent, secrets, roles.
    (AuditLogs | where TimeGenerated between (StartTime .. EndTime) | extend Phase = "6-Directory", Source = "AuditLogs", Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)), Detail = strcat(OperationName, " | ", Result, " | ", tostring(InitiatedBy.user.ipAddress), " | cel=", tostring(TargetResources))),
    // PHASE 7 — cloud activity. Mailbox rules, downloads, sharing.
    (OfficeActivity | where TimeGenerated between (StartTime .. EndTime) | where Operation !has "MailItemsAccessed" | extend Phase = "7-Cloud", Source = "OfficeActivity", Actor = UserId, Detail = strcat(OfficeWorkload, " | ", Operation, " | ", ResultStatus, " | ", ClientIP, " | ", MailboxOwnerUPN))
| where Actor contains UserIdentityCheck
| project-rename EventTime = TimeGenerated
| project EventTime, Phase, Source, Actor, Detail
| sort by EventTime asc
//
//| where Phase startswith "2-" or Phase startswith "4-"   // token issue and token use only
//| where Phase startswith "6-"                            // directory changes only
//| summarize Events = count(), First = min(EventTime), Last = max(EventTime) by Phase

//Hands-on-keyboard timeline query
//
// The intrusion on one device as a single table, oldest first, tagged by phase and ATT&CK
// technique. The Technique column is the IOA list for the ticket.
let IncidentStart = ago(1d);              // first known attacker activity, e.g. datetime(2026-10-05T14:32:00Z)
let IncidentEnd = now();
let LookBefore = 7d;
let LookAfter = 1d;
let DeviceCheck = "";
let UserIdentityCheck = "";
//
let StartTime = IncidentStart - LookBefore;
let EndTime = IncidentEnd + LookAfter;
let Shells = dynamic(["cmd.exe","powershell.exe","pwsh.exe","powershell_ise.exe","wt.exe","bash.exe","wsl.exe","mshta.exe","wscript.exe","cscript.exe","rundll32.exe","regsvr32.exe"]);
let RemoteExecParents = dynamic(["wmiprvse.exe","wsmprovhost.exe","winrshost.exe","psexesvc.exe","paexecsvc.exe","services.exe"]);
// Server software that should never start a shell. A shell under one of these is a web shell or an exploit.
let ServerApps = dynamic(["w3wp.exe","httpd.exe","nginx.exe","tomcat.exe","tomcat9.exe","java.exe","sqlservr.exe","php-cgi.exe","node.exe","UMWorkerProcess.exe","MSExchangeMailboxReplication.exe"]);
let OfficeApps = dynamic(["winword.exe","excel.exe","powerpnt.exe","outlook.exe","onenote.exe","msaccess.exe","mspub.exe","teams.exe","ms-teams.exe"]);
let DiscoveryBins = dynamic(["whoami.exe","systeminfo.exe","ipconfig.exe","nltest.exe","net.exe","net1.exe","netstat.exe","arp.exe","route.exe","tasklist.exe","quser.exe","qwinsta.exe","query.exe","hostname.exe","nslookup.exe","nbtstat.exe","dsquery.exe","setspn.exe","klist.exe","cmdkey.exe","wmic.exe","csvde.exe","ldifde.exe","netdom.exe","adfind.exe"]);
let StagePaths = dynamic([@"\programdata\",@"\users\public\",@"\perflogs\",@"\windows\temp\",@"\appdata\local\temp\",@"\$recycle.bin\"]);
let RmmPattern = @"(?i)(anydesk|screenconnect|connectwise|atera|splashtop|teamviewer|rustdesk|netsupport|client32|meshagent|syncro|action1|logmein|gotoassist|supremo|ultraviewer|dwagent|tightvnc|quickassist)";
let CredPattern = @"(?i)(comsvcs.*minidump|procdump.*lsass|sekurlsa|lsadump|invoke-mimikatz|mimikatz|kerberoast|rubeus|ntdsutil|ntds\.dit|reg(\.exe)?\s+save\s+hklm\\(sam|security|system)|vssadmin(\.exe)?\s+create\s+shadow|esentutl.*ntds|lazagne)";
let LateralPattern = @"(?i)(psexec|paexec|wmic(\.exe)?\s+/node:|invoke-command\s.*-computername|enter-pssession|new-pssession|winrs(\.exe)?\s+-r:|sc(\.exe)?\s+\\\\|schtasks(\.exe)?\s.*/s\s|mstsc(\.exe)?\s.*/v:|copy\s.*\\\\[^\\]+\\(admin|c)\$)";
let EvasionPattern = @"(?i)(wevtutil(\.exe)?\s+(cl|clear-log)|clear-eventlog|remove-eventlog|auditpol(\.exe)?\s+/clear|set-mppreference|add-mppreference|disablerealtimemonitoring|advfirewall\s+set\s+\w+\s+state\s+off|sc(\.exe)?\s+(stop|config)\s+windefend)";
let ArchivePattern = @"(?i)(\b(7z|7za|7zr|rar|winrar)(\.exe)?\s+a\s|compress-archive|zipfile\]::createfromdirectory|tar(\.exe)?\s+-?c|makecab)";
let ExfilPattern = @"(?i)(rclone|megacmd|mega-put|megasync|winscp|filezilla|pscp|psftp|restic|azcopy|s3browser|gsutil|aws\s+s3\s+(cp|sync)|curl(\.exe)?\s.*(\s-T\s|--upload-file|\s-F\s|--data-binary\s+@)|-transfertype\s+upload|invoke-(webrequest|restmethod).*-infile)";
let TunnelPattern = @"(?i)(ngrok|cloudflared|chisel|plink|frpc|gost|ligolo)";
let RecoveryPattern = @"(?i)(vssadmin(\.exe)?\s+(delete\s+shadows|resize\s+shadowstorage)|shadowcopy\s+delete|wbadmin(\.exe)?\s+delete|recoveryenabled\s+no|bootstatuspolicy\s+ignoreallfailures|usn\s+deletejournal)";
let StopPattern = @"(?i)((net|sc)(\.exe)?\s+stop\s|taskkill(\.exe)?\s.*/im\s.*(sql|backup|veeam|vss|exchange|oracle))";
//
union isfuzzy=true
    // 01 ACCESS — how they arrived: remote logons, password guessing, remote tools, exploited servers, documents.
    (DeviceLogonEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where LogonType in~ ("RemoteInteractive","Network","NetworkCleartext","NewCredentials") | where ActionType =~ "LogonSuccess" | extend Phase = "01-Access", Technique = iff(LogonType =~ "RemoteInteractive", "T1021.001", "T1078"), Source = "DeviceLogonEvents", Actor = AccountName, Detail = strcat(LogonType, " logon by ", AccountDomain, "\\", AccountName, " from ", RemoteDeviceName, " ", RemoteIP, iff(IsLocalAdmin == true, " (local admin)", ""))),
    (DeviceLogonEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType =~ "LogonFailed" | summarize FirstTime = min(TimeGenerated), Failures = count(), Accounts = dcount(AccountName), Tried = make_set(AccountName, 5), Reasons = make_set(FailureReason, 3) by DeviceName, RemoteIP, LogonType, Slot = bin(TimeGenerated, 1h) | where Failures >= 5 | extend TimeGenerated = FirstTime, Phase = "01-Access", Technique = iff(Accounts > 3, "T1110.003", "T1110.001"), Source = "DeviceLogonEvents", Actor = strcat_array(Tried, ", "), Detail = strcat(Failures, " failed ", LogonType, " logons for ", Accounts, " accounts from ", RemoteIP, " | ", strcat_array(Reasons, ", "))),
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where FileName matches regex RmmPattern | extend Phase = "01-Access", Technique = "T1219", Source = "DeviceProcessEvents", Actor = AccountName, Detail = strcat("remote access tool ", FolderPath, " | parent ", InitiatingProcessFileName, " | ", ProcessCommandLine)),
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where InitiatingProcessFileName in~ (ServerApps) and FileName in~ (Shells) | extend Phase = "01-Access", Technique = "T1190", Source = "DeviceProcessEvents", Actor = AccountName, Detail = strcat(InitiatingProcessFileName, " started ", FileName, " | ", ProcessCommandLine)),
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where InitiatingProcessFileName in~ (OfficeApps) and FileName in~ (Shells) | extend Phase = "01-Access", Technique = "T1204.002", Source = "DeviceProcessEvents", Actor = AccountName, Detail = strcat(InitiatingProcessFileName, " started ", FileName, " | ", ProcessCommandLine)),
    // 02 EXECUTION — shells driven by a person or a remote tool, and anything run out of a staging folder.
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where FileName in~ (Shells) | where IsProcessRemoteSession == true or InitiatingProcessFileName in~ (RemoteExecParents) or InitiatingProcessFileName matches regex RmmPattern or InitiatingProcessFileName in~ (Shells) | extend Phase = "02-Execution", Technique = case(FileName in~ ("powershell.exe","pwsh.exe","powershell_ise.exe"), "T1059.001", FileName =~ "cmd.exe", "T1059.003", InitiatingProcessFileName =~ "wmiprvse.exe", "T1047", InitiatingProcessFileName in~ ("wsmprovhost.exe","winrshost.exe"), "T1021.006", "T1059"), Source = "DeviceProcessEvents", Actor = AccountName, Detail = strcat(InitiatingProcessFileName, " > ", ProcessCommandLine, iff(IsProcessRemoteSession == true, strcat(" | RDP from ", ProcessRemoteSessionIP), ""))),
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where FolderPath has_any (StagePaths) | where FileName endswith ".exe" | extend Phase = "02-Execution", Technique = "T1204.002", Source = "DeviceProcessEvents", Actor = AccountName, Detail = strcat("ran from staging folder: ", FolderPath, " | SHA256=", SHA256, " | ", ProcessCommandLine)),
    (DeviceEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType == "PowerShellCommand" | extend Phase = "02-Execution", Technique = "T1059.001", Source = "DeviceEvents", Actor = InitiatingProcessAccountName, Detail = strcat("PowerShell: ", tostring(todynamic(AdditionalFields).Command))),
    // 03 DISCOVERY — the recon a person runs before they decide what to do.
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where FileName in~ (DiscoveryBins) or ProcessCommandLine has_any ("Get-ADUser","Get-ADComputer","Get-ADGroupMember","Get-ADTrust","Get-NetUser","Get-DomainUser","Invoke-ShareFinder","Find-LocalAdminAccess","Get-SmbShare") | extend Phase = "03-Discovery", Technique = case(ProcessCommandLine has_any ("domain_trusts","trustdmp","Get-ADTrust"), "T1482", ProcessCommandLine has_any ("group","localgroup","Get-ADGroupMember"), "T1069", FileName in~ ("net.exe","net1.exe") and ProcessCommandLine has "user", "T1087", FileName in~ ("net.exe","net1.exe") and ProcessCommandLine has_any ("view","share"), "T1135", ProcessCommandLine has_any ("Invoke-ShareFinder","Get-SmbShare"), "T1135", FileName in~ ("ipconfig.exe","arp.exe","route.exe","nbtstat.exe"), "T1016", FileName =~ "netstat.exe", "T1049", FileName in~ ("whoami.exe","quser.exe","qwinsta.exe","query.exe"), "T1033", FileName =~ "tasklist.exe", "T1057", FileName in~ ("systeminfo.exe","hostname.exe"), "T1082", FileName in~ ("nltest.exe","dsquery.exe","adfind.exe","csvde.exe","ldifde.exe","setspn.exe") or ProcessCommandLine has_any ("Get-ADUser","Get-ADComputer","Get-DomainUser"), "T1087.002", FileName in~ ("ping.exe","nslookup.exe","netdom.exe"), "T1018", "TA0007"), Source = "DeviceProcessEvents", Actor = AccountName, Detail = strcat(InitiatingProcessFileName, " > ", ProcessCommandLine)),
    (IdentityQueryEvents | where TimeGenerated between (StartTime .. EndTime) | where isnotempty(DeviceCheck) and DeviceName contains DeviceCheck | extend Phase = "03-Discovery", Technique = "T1087.002", Source = "IdentityQueryEvents", Actor = iff(isnotempty(AccountUpn), AccountUpn, AccountName), Detail = strcat(Protocol, " ", QueryType, " against ", DestinationDeviceName, " | target ", QueryTarget)),
    // 04 CREDENTIAL ACCESS — LSASS, the SAM and SECURITY hives, NTDS, Kerberos.
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ProcessCommandLine matches regex CredPattern or FileName matches regex @"(?i)(mimikatz|procdump|nanodump|rubeus|lazagne)" | extend Phase = "04-Credential", Technique = case(ProcessCommandLine has_any ("ntds","ntdsutil"), "T1003.003", ProcessCommandLine has_any ("sam","security","system") and ProcessCommandLine has "save", "T1003.002", ProcessCommandLine has_any ("kerberoast","rubeus"), "T1558.003", ProcessCommandLine has "lazagne" or FileName has "lazagne", "T1555", "T1003.001"), Source = "DeviceProcessEvents", Actor = AccountName, Detail = ProcessCommandLine),
    (DeviceEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where (ActionType in~ ("OpenProcessApiCall","ReadProcessMemoryApiCall") and FileName =~ "lsass.exe") or ActionType startswith "AsrLsassCredentialTheft" | extend Phase = "04-Credential", Technique = "T1003.001", Source = "DeviceEvents", Actor = InitiatingProcessAccountName, Detail = strcat(ActionType, " by ", InitiatingProcessFileName, " | ", InitiatingProcessCommandLine)),
    // 05 LATERAL MOVEMENT — out to other hosts, and tools pushed in over SMB.
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ProcessCommandLine matches regex LateralPattern | extend Phase = "05-Lateral", Technique = case(ProcessCommandLine has "mstsc", "T1021.001", ProcessCommandLine has_any ("psexec","paexec") or ProcessCommandLine matches regex @"(?i)sc(\.exe)?\s+\\\\", "T1569.002", ProcessCommandLine has "wmic", "T1047", ProcessCommandLine has_any ("Invoke-Command","PSSession","winrs"), "T1021.006", ProcessCommandLine has "schtasks", "T1053.005", "T1021.002"), Source = "DeviceProcessEvents", Actor = AccountName, Detail = ProcessCommandLine),
    (DeviceNetworkEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType =~ "ConnectionSuccess" and RemoteIPType == "Private" and RemotePort in (3389, 445, 5985, 5986, 22) | where InitiatingProcessFileName !in~ ("svchost.exe","System","MsSense.exe","MsMpEng.exe") | extend Phase = "05-Lateral", Technique = case(RemotePort == 3389, "T1021.001", RemotePort == 445, "T1021.002", RemotePort == 22, "T1021.004", "T1021.006"), Source = "DeviceNetworkEvents", Actor = InitiatingProcessAccountName, Detail = strcat(InitiatingProcessFileName, " -> ", RemoteIP, ":", RemotePort)),
    (DeviceFileEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where isnotempty(RequestSourceIP) | where FileName matches regex @"(?i)\.(exe|dll|ps1|bat|cmd|vbs|js|hta|msi|sys)$" | extend Phase = "05-Lateral", Technique = "T1570", Source = "DeviceFileEvents", Actor = RequestAccountName, Detail = strcat("written over ", RequestProtocol, " from ", RequestSourceIP, " into ", ShareName, " | ", FolderPath, " | SHA256=", SHA256)),
    // 06 PERSISTENCE — services, tasks, run keys, new accounts.
    (DeviceEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType =~ "ServiceInstalled" or ActionType startswith "ScheduledTask" | extend Phase = "06-Persistence", Technique = iff(ActionType =~ "ServiceInstalled", "T1543.003", "T1053.005"), Source = "DeviceEvents", Actor = InitiatingProcessAccountName, Detail = strcat(ActionType, " | ", FileName, " | ", FolderPath, " | ", tostring(AdditionalFields))),
    (DeviceRegistryEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType =~ "RegistryValueSet" | where RegistryKey has_any (@"CurrentVersion\Run", @"CurrentVersion\RunOnce", @"Policies\Explorer\Run", "Winlogon", "Image File Execution Options") | extend Phase = "06-Persistence", Technique = iff(RegistryKey has "Image File Execution Options", "T1546.012", "T1547.001"), Source = "DeviceRegistryEvents", Actor = InitiatingProcessAccountName, Detail = strcat(InitiatingProcessFileName, " set ", RegistryKey, "\\", RegistryValueName, " = ", RegistryValueData)),
    (DeviceEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType in~ ("UserAccountCreated","UserAccountAddedToLocalGroup") | extend Phase = "06-Persistence", Technique = iff(ActionType =~ "UserAccountCreated", "T1136.001", "T1098"), Source = "DeviceEvents", Actor = InitiatingProcessAccountName, Detail = strcat(ActionType, ": ", AccountDomain, "\\", AccountName, " by ", InitiatingProcessFileName)),
    // 07 DEFENCE EVASION — the attacker clearing their own path. Telemetry after this point is suspect.
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ProcessCommandLine matches regex EvasionPattern | extend Phase = "07-Evasion", Technique = case(ProcessCommandLine has_any ("wevtutil","eventlog","auditpol"), "T1070.001", ProcessCommandLine has "advfirewall", "T1562.004", "T1562.001"), Source = "DeviceProcessEvents", Actor = AccountName, Detail = ProcessCommandLine),
    (DeviceEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType in~ ("TamperingAttempt","AntivirusDetection","AntivirusReport") | extend Phase = "07-Evasion", Technique = iff(ActionType =~ "TamperingAttempt", "T1562.001", "Detection"), Source = "DeviceEvents", Actor = InitiatingProcessAccountName, Detail = strcat(ActionType, " | ", FileName, " | ", FolderPath, " | ", InitiatingProcessFileName)),
    // 08 COLLECTION — data gathered and packed up.
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ProcessCommandLine matches regex ArchivePattern | extend Phase = "08-Collection", Technique = iff(ProcessCommandLine has_any ("Compress-Archive","ZipFile"), "T1560", "T1560.001"), Source = "DeviceProcessEvents", Actor = AccountName, Detail = ProcessCommandLine),
    // 09 EXFILTRATION — the tools and channels that take it out.
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where FileName matches regex ExfilPattern or ProcessCommandLine matches regex ExfilPattern | extend Phase = "09-Exfil", Technique = iff(ProcessCommandLine has_any ("rclone","mega","s3","azcopy","gsutil"), "T1567.002", "T1048"), Source = "DeviceProcessEvents", Actor = AccountName, Detail = ProcessCommandLine),
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where FileName matches regex TunnelPattern or ProcessCommandLine matches regex TunnelPattern | extend Phase = "09-Exfil", Technique = "T1572", Source = "DeviceProcessEvents", Actor = AccountName, Detail = ProcessCommandLine),
    // 10 IMPACT — recovery removed, services stopped, files rewritten.
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ProcessCommandLine matches regex RecoveryPattern | extend Phase = "10-Impact", Technique = "T1490", Source = "DeviceProcessEvents", Actor = AccountName, Detail = ProcessCommandLine),
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ProcessCommandLine matches regex StopPattern | extend Phase = "10-Impact", Technique = "T1489", Source = "DeviceProcessEvents", Actor = AccountName, Detail = ProcessCommandLine),
    (DeviceFileEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType =~ "FileRenamed" | extend NewExt = tolower(extract(@"\.([^.\\]+)$", 1, FileName)), OldExt = tolower(extract(@"\.([^.\\]+)$", 1, PreviousFileName)) | where isnotempty(OldExt) and NewExt != OldExt | summarize FirstTime = min(TimeGenerated), Files = count(), NewExts = make_set(NewExt, 5), By = make_set(InitiatingProcessFileName, 3), Actor = take_any(InitiatingProcessAccountName) by DeviceName, Slot = bin(TimeGenerated, 5m) | where Files >= 100 | extend TimeGenerated = FirstTime, Phase = "10-Impact", Technique = "T1486", Source = "DeviceFileEvents", Detail = strcat(Files, " files renamed to a new extension in 5 minutes: ", strcat_array(NewExts, ", "), " by ", strcat_array(By, ", ")))
| where Actor contains UserIdentityCheck
| extend Window = case(TimeGenerated < IncidentStart, "1-Before", TimeGenerated <= IncidentEnd, "2-During", "3-After")
| project-rename EventTime = TimeGenerated
| project EventTime, Window, Phase, Technique, Source, DeviceName, Actor, Detail
| sort by EventTime asc
//
//| where Window == "2-During"                               // the incident window only
//| where Phase in ("01-Access","02-Execution")              // push T0 back: the earliest rows here are your starting point
//| summarize Events = count(), First = min(EventTime), Last = max(EventTime), Techniques = make_set(Technique, 20) by Phase  // the IOA list for the ticket
//| summarize Events = count() by bin(EventTime, 1h), Phase  // when they were working — gaps are them sleeping, or another host

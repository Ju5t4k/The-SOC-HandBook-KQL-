//ClickFix timeline query
//
// Set PivotTime to the moment of the paste (EventTime from clickfix.kql).
let PivotTime = now();
let BeforeWindow = 2h;
let AfterWindow = 24h;
let DeviceCheck = "";
let UserIdentityCheck = "";
//
let StartTime = PivotTime - BeforeWindow;
let EndTime = PivotTime + AfterWindow;
let Browsers = dynamic(["msedge.exe","chrome.exe","firefox.exe","brave.exe","opera.exe","iexplore.exe"]);
let LolBins = dynamic(["powershell.exe","pwsh.exe","cmd.exe","mshta.exe","wscript.exe","cscript.exe","rundll32.exe","regsvr32.exe","curl.exe","certutil.exe","bitsadmin.exe","msiexec.exe","forfiles.exe","schtasks.exe","sc.exe","reg.exe"]);
let DefenceActions = dynamic(["AntivirusDetection","AntivirusReport","TamperingAttempt","ExploitGuardNetworkProtectionBlocked","SecurityControlConfigurationChange","AntivirusConfigurationChange","AsrLsassCredentialTheftBlocked","AntivirusScanCancelled"]);
//
union isfuzzy=true
    // PHASE 1 — the lure. The page the command was copied from.
    (DeviceEvents | where TimeGenerated between (StartTime .. EndTime) | where ActionType == "BrowserLaunchedToOpenUrl" | where isnotempty(RemoteUrl) | extend Phase = "1-Lure", Source = "DeviceEvents", Actor = AccountName, Detail = strcat("browser opened: ", RemoteUrl, " | ", InitiatingProcessFileName)),
    (DeviceNetworkEvents | where TimeGenerated between (StartTime .. EndTime) | where InitiatingProcessFileName in~ (Browsers) | where isnotempty(RemoteUrl) | extend Phase = "1-Lure", Source = "DeviceNetworkEvents", Actor = InitiatingProcessAccountName, Detail = strcat("browser traffic: ", RemoteUrl, " (", RemoteIP, ":", tostring(RemotePort), ")")),
    // PHASE 2 — the paste. RunMRU is proof the Run dialog was used.
    (DeviceRegistryEvents | where TimeGenerated between (StartTime .. EndTime) | where RegistryKey has @"Explorer\RunMRU" | where isnotempty(RegistryValueData) | extend Phase = "2-Paste", Source = "DeviceRegistryEvents", Actor = InitiatingProcessAccountName, Detail = strcat("RunMRU [", RegistryValueName, "] = ", RegistryValueData)),
    // PHASE 3 — execution.
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where FileName in~ (LolBins) or InitiatingProcessFileName =~ "explorer.exe" | extend Phase = "3-Execution", Source = "DeviceProcessEvents", Actor = AccountName, Detail = strcat(InitiatingProcessFileName, " -> ", FileName, " | ", ProcessCommandLine)),
    // PHASE 4 — payload fetch. Traffic from something other than a browser.
    (DeviceNetworkEvents | where TimeGenerated between (StartTime .. EndTime) | where InitiatingProcessFileName !in~ (Browsers) | where RemoteIPType == "Public" | extend Phase = "4-Download", Source = "DeviceNetworkEvents", Actor = InitiatingProcessAccountName, Detail = strcat(InitiatingProcessFileName, " -> ", iff(isnotempty(RemoteUrl), RemoteUrl, RemoteIP), ":", tostring(RemotePort))),
    // PHASE 5 — written to disk. FileOriginUrl says where the file came from.
    (DeviceFileEvents | where TimeGenerated between (StartTime .. EndTime) | where ActionType in~ ("FileCreated","FileModified","FileRenamed") | extend Phase = "5-Disk", Source = "DeviceFileEvents", Actor = InitiatingProcessAccountName, Detail = strcat(InitiatingProcessFileName, " wrote ", FolderPath, " | SHA256=", SHA256, " | origin=", FileOriginUrl)),
    // PHASE 6 — persistence.
    (DeviceRegistryEvents | where TimeGenerated between (StartTime .. EndTime) | where RegistryKey contains @"CurrentVersion\Run" or RegistryKey contains @"CurrentVersion\RunOnce" or RegistryKey contains "Winlogon" or RegistryKey contains "Image File Execution Options" or RegistryKey contains @"Policies\Explorer\Run" | extend Phase = "6-Persistence", Source = "DeviceRegistryEvents", Actor = InitiatingProcessAccountName, Detail = strcat(InitiatingProcessFileName, " set ", RegistryKey, "\\", RegistryValueName, " = ", RegistryValueData)),
    // PHASE 7 — defensive reaction. Empty does not mean clean.
    (DeviceEvents | where TimeGenerated between (StartTime .. EndTime) | where ActionType in~ (DefenceActions) | extend Phase = "7-Defence", Source = "DeviceEvents", Actor = AccountName, Detail = strcat(ActionType, " | ", FileName, " | ", FolderPath)),
    // PHASE 8 — identity. Token theft shows here, not on the endpoint.
    (SigninLogs | where TimeGenerated between (StartTime .. EndTime) | extend Phase = "8-Identity", Source = "SigninLogs", DeviceName = tostring(DeviceDetail.displayName), Actor = UserPrincipalName, Detail = strcat("sign-in ", ResultType, " ", ResultDescription, " | ", IPAddress, " | ", tostring(LocationDetails.countryOrRegion), " | ", AppDisplayName)),
    // PHASE 9 — cloud. Mailbox rules, downloads, sharing.
    (OfficeActivity | where TimeGenerated between (StartTime .. EndTime) | extend Phase = "9-Cloud", Source = "OfficeActivity", DeviceName = "", Actor = UserId, Detail = strcat(OfficeWorkload, " | ", Operation, " | ", ResultStatus, " | ", ClientIP))
// Cloud events carry no device name — DeviceCheck must not cut them out.
| where isempty(DeviceName) or DeviceName contains DeviceCheck
| where Actor contains UserIdentityCheck
| project-rename EventTime = TimeGenerated
| project EventTime, Phase, Source, DeviceName, Actor, Detail
| sort by EventTime asc
//
//| where Phase startswith "1-" or Phase startswith "2-"   // lure and paste only
//| where Phase !startswith "8-" and Phase !startswith "9-" // endpoint only
//| summarize Events = count(), First = min(EventTime), Last = max(EventTime) by Phase  // how much of what in each phase

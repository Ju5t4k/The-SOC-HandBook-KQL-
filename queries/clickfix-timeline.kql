//ClickFix timeline query
//
// The ClickFix incident in order. Set PivotTime to EventTime from clickfix.kql.
let PivotTime = now();
let BeforeWindow = 2h;
let AfterWindow = 24h;
let DeviceCheck = "";
let UserIdentityCheck = "";
//
let StartTime = PivotTime - BeforeWindow;
let EndTime = PivotTime + AfterWindow;
let Browsers = dynamic(["msedge.exe","chrome.exe","firefox.exe","brave.exe","opera.exe","iexplore.exe"]);
let LolBins = dynamic(["powershell.exe","pwsh.exe","cmd.exe","mshta.exe","wscript.exe","cscript.exe","rundll32.exe","regsvr32.exe","curl.exe","certutil.exe","bitsadmin.exe","msiexec.exe","forfiles.exe","schtasks.exe","sc.exe","reg.exe"]);
let UserPaths = dynamic([@"\appdata\",@"\temp\",@"\programdata\",@"\users\public\",@"\downloads\"]);
let DefenceActions = dynamic(["AntivirusDetection","AntivirusReport","TamperingAttempt","ExploitGuardNetworkProtectionBlocked","SecurityControlConfigurationChange","AntivirusConfigurationChange","AsrLsassCredentialTheftBlocked","AntivirusScanCancelled"]);
//
union isfuzzy=true
    // 1 — the page the command was copied from.
    (DeviceEvents | where TimeGenerated between (StartTime .. EndTime) | where ActionType == "BrowserLaunchedToOpenUrl" | where isnotempty(RemoteUrl) | extend Phase = "1-Lure", Source = "DeviceEvents", Actor = AccountName, Detail = strcat("browser opened: ", RemoteUrl, " | ", InitiatingProcessFileName)),
    (DeviceNetworkEvents | where TimeGenerated between (StartTime .. EndTime) | where InitiatingProcessFileName in~ (Browsers) | where isnotempty(RemoteUrl) | extend Phase = "1-Lure", Source = "DeviceNetworkEvents", Actor = InitiatingProcessAccountName, Detail = strcat("browser traffic: ", RemoteUrl, " (", RemoteIP, ":", tostring(RemotePort), ")")),
    // A lure that arrived by mail or Teams.
    (UrlClickEvents | where TimeGenerated between (StartTime .. EndTime) | extend Phase = "1-Lure", Source = "UrlClickEvents", DeviceName = "", Actor = AccountUpn, Detail = strcat("Safe Links click from ", Workload, ": ", Url, " | verdict=", ThreatTypes, " | ", ActionType, iff(IsClickedThrough, " | clicked through the warning", ""))),
    // 2 — the paste. RunMRU = Win+R, TypedPaths = Explorer address bar.
    (DeviceRegistryEvents | where TimeGenerated between (StartTime .. EndTime) | where RegistryKey has @"Explorer\RunMRU" or RegistryKey has @"Explorer\TypedPaths" | where isnotempty(RegistryValueData) | extend Phase = "2-Paste", Source = "DeviceRegistryEvents", Actor = InitiatingProcessAccountName, Detail = strcat(iff(RegistryKey has "RunMRU", "Win+R", "Explorer address bar"), " [", RegistryValueName, "] = ", RegistryValueData)),
    // Commands pasted into an open console. Needs script block logging.
    (DeviceEvents | where TimeGenerated between (StartTime .. EndTime) | where ActionType == "PowerShellCommand" | extend Phase = "2-Paste", Source = "DeviceEvents", Actor = AccountName, Detail = strcat("console command: ", tostring(todynamic(AdditionalFields).Command))),
    // 3 — what the desktop and the LOLBins ran.
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where FileName in~ (LolBins) or InitiatingProcessFileName =~ "explorer.exe" | extend Phase = "3-Execution", Source = "DeviceProcessEvents", Actor = AccountName, Detail = strcat(InitiatingProcessFileName, " -> ", FileName, " | ", ProcessCommandLine)),
    // 4 — downloads by a LOLBin, or by something running from a user-writable folder.
    (DeviceNetworkEvents | where TimeGenerated between (StartTime .. EndTime) | where InitiatingProcessFileName in~ (LolBins) or InitiatingProcessFolderPath has_any (UserPaths) | where RemoteIPType == "Public" | extend Phase = "4-Download", Source = "DeviceNetworkEvents", Actor = InitiatingProcessAccountName, Detail = strcat(InitiatingProcessFileName, " -> ", iff(isnotempty(RemoteUrl), RemoteUrl, RemoteIP), ":", tostring(RemotePort))),
    // 5 — files from the web, and executables, scripts and archives written. FileOriginUrl is the source.
    (DeviceFileEvents | where TimeGenerated between (StartTime .. EndTime) | where ActionType in~ ("FileCreated","FileModified","FileRenamed") | where isnotempty(FileOriginUrl) or FileName matches regex @"(?i)\.(exe|dll|ps1|bat|cmd|vbs|js|hta|msi|lnk|zip|7z|rar|iso)$" | extend Phase = "5-Disk", Source = "DeviceFileEvents", Actor = InitiatingProcessAccountName, Detail = strcat(InitiatingProcessFileName, " wrote ", FolderPath, " | SHA256=", SHA256, " | origin=", FileOriginUrl)),
    // 6 — autoruns written in the window.
    (DeviceRegistryEvents | where TimeGenerated between (StartTime .. EndTime) | where RegistryKey contains @"CurrentVersion\Run" or RegistryKey contains @"CurrentVersion\RunOnce" or RegistryKey contains "Winlogon" or RegistryKey contains "Image File Execution Options" or RegistryKey contains @"Policies\Explorer\Run" | extend Phase = "6-Persistence", Source = "DeviceRegistryEvents", Actor = InitiatingProcessAccountName, Detail = strcat(InitiatingProcessFileName, " set ", RegistryKey, "\\", RegistryValueName, " = ", RegistryValueData)),
    // 7 — what AV, ASR and tamper protection did. Empty proves nothing.
    (DeviceEvents | where TimeGenerated between (StartTime .. EndTime) | where ActionType in~ (DefenceActions) | extend Phase = "7-Defence", Source = "DeviceEvents", Actor = AccountName, Detail = strcat(ActionType, " | ", FileName, " | ", FolderPath)),
    // 8 — interactive sign-ins.
    (SigninLogs | where TimeGenerated between (StartTime .. EndTime) | extend Phase = "8-Identity", Source = "SigninLogs", DeviceName = tostring(DeviceDetail.displayName), Actor = UserPrincipalName, Detail = strcat("sign-in ", ResultType, " ", ResultDescription, " | ", IPAddress, " | ", tostring(LocationDetails.countryOrRegion), " | ", AppDisplayName)),
    // Token replay is non-interactive. It only shows here.
    (AADNonInteractiveUserSignInLogs | where TimeGenerated between (StartTime .. EndTime) | extend Phase = "8-Identity", Source = "AADNonInteractiveUserSignInLogs", DeviceName = tostring(todynamic(DeviceDetail).displayName), Actor = UserPrincipalName, Detail = strcat("token use ", ResultType, " | ", IPAddress, " | AS", AutonomousSystemNumber, " | ", tostring(todynamic(LocationDetails).countryOrRegion), " | ", AppDisplayName, " | ", IncomingTokenType)),
    // What the session changed: MFA methods, consent, roles, passwords.
    (AuditLogs | where TimeGenerated between (StartTime .. EndTime) | where OperationName has_any ("authentication method","consent","Add member to role","Add service principal","Add app role assignment","password","Register device","registered owner","Update user") | extend Phase = "8-Identity", Source = "AuditLogs", DeviceName = "", Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)), Detail = strcat(OperationName, " | ", Result, " | target=", tostring(TargetResources[0].displayName))),
    // 9 — Microsoft 365 activity, mail reads left out.
    (OfficeActivity | where TimeGenerated between (StartTime .. EndTime) | where Operation !in~ ("MailItemsAccessed") | extend Phase = "9-Cloud", Source = "OfficeActivity", DeviceName = "", Actor = UserId, Detail = strcat(OfficeWorkload, " | ", Operation, " | ", ResultStatus, " | ", ClientIP))
// Cloud rows have no device name, so DeviceCheck must not remove them.
| where isempty(DeviceName) or DeviceName contains DeviceCheck
| where Actor contains UserIdentityCheck
| project-rename EventTime = TimeGenerated
| project EventTime, Phase, Source, DeviceName, Actor, Detail
| sort by EventTime asc
//
//| where Phase startswith "1-" or Phase startswith "2-"   // lure and paste only
//| where Phase !startswith "8-" and Phase !startswith "9-" // endpoint only
//| where Source == "AADNonInteractiveUserSignInLogs"       // token replay only
//| summarize Events = count(), First = min(EventTime), Last = max(EventTime) by Phase  // how much of what in each phase

//Hands-on-keyboard lateral movement query
//
// Where they went next. Hops out of this device, seen from both ends, and every device the
// compromised account touched. Every destination here is another device to investigate.
let IncidentStart = ago(1d);              // first known attacker activity, e.g. datetime(2026-10-05T14:32:00Z)
let IncidentEnd = now();
let LookBefore = 1d;
let LookAfter = 3d;
let DeviceCheck = "";                     // the source device — hops out of it
let UserIdentityCheck = "";               // the compromised account — everywhere it logged on
//
let StartTime = IncidentStart - LookBefore;
let EndTime = IncidentEnd + LookAfter;
let AdminPorts = dynamic([22,135,139,445,3389,5985,5986,5900]);
let LateralPattern = @"(?i)(psexec|paexec|wmic(\.exe)?\s+/node:|invoke-command\s.*-computername|enter-pssession|new-pssession|winrs(\.exe)?\s+-r:|sc(\.exe)?\s+\\\\|schtasks(\.exe)?\s.*/s\s|mstsc(\.exe)?\s.*/v:|copy\s.*\\\\[^\\]+\\(admin|c)\$)";
// Every address the source device held in the window. Blank DeviceCheck leaves this empty on purpose.
let DeviceIPs = DeviceNetworkInfo | where TimeGenerated between (StartTime .. EndTime) | where isnotempty(DeviceCheck) and DeviceName contains DeviceCheck | mv-expand IPEntry = IPAddresses | extend IP = tostring(IPEntry.IPAddress) | where isnotempty(IP) and IP !startswith "127." and IP != "::1" and IP !startswith "fe80" | distinct IP;
let IpToDevice = DeviceNetworkInfo | where TimeGenerated between (StartTime .. EndTime) | mv-expand IPEntry = IPAddresses | extend IP = tostring(IPEntry.IPAddress) | where isnotempty(IP) | summarize ResolvedDevice = strcat_array(make_set(DeviceName, 3), " / ") by IP;
//
union isfuzzy=true
    // FROM the device: connections to admin ports on internal hosts.
    (DeviceNetworkEvents | where TimeGenerated between (StartTime .. EndTime) | where isnotempty(DeviceCheck) and DeviceName contains DeviceCheck | where RemoteIPType == "Private" and RemotePort in (AdminPorts) | where ActionType in~ ("ConnectionSuccess","ConnectionFailed") | where InitiatingProcessFileName !in~ ("MsSense.exe","MsMpEng.exe","SenseNdr.exe") | extend Seen = "From the device", Method = case(RemotePort == 3389, "RDP", RemotePort in (445, 139), "SMB", RemotePort == 135, "RPC/WMI", RemotePort in (5985, 5986), "WinRM", RemotePort == 22, "SSH", "VNC"), Source = DeviceName, DestinationIP = RemoteIP, Destination = RemoteIP, Account = InitiatingProcessAccountName, Result = ActionType, Detail = strcat(InitiatingProcessFileName, " -> ", RemoteIP, ":", RemotePort)),
    // FROM the device: remote execution typed or scripted on the command line, with the target pulled out.
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where isnotempty(DeviceCheck) and DeviceName contains DeviceCheck | where ProcessCommandLine matches regex LateralPattern | extend T1 = extract(@"\\\\([^\\\s]+)", 1, ProcessCommandLine), T2 = extract(@"(?i)/node:\x22?([^\s\x22,]+)", 1, ProcessCommandLine), T3 = extract(@"(?i)-computername\s+\x22?([^\s\x22,]+)", 1, ProcessCommandLine), T4 = extract(@"(?i)/v:\x22?([^\s\x22]+)", 1, ProcessCommandLine), T5 = extract(@"(?i)-r:\x22?([^\s\x22]+)", 1, ProcessCommandLine), T6 = extract(@"(?i)/s\s+\x22?([^\s\x22]+)", 1, ProcessCommandLine) | extend Target = case(isnotempty(T1), T1, isnotempty(T2), T2, isnotempty(T3), T3, isnotempty(T4), T4, isnotempty(T5), T5, T6) | extend Seen = "From the device", Method = case(ProcessCommandLine has "mstsc", "RDP", ProcessCommandLine has_any ("psexec","paexec"), "PsExec", ProcessCommandLine has "wmic", "WMI", ProcessCommandLine has_any ("Invoke-Command","PSSession","winrs"), "WinRM", ProcessCommandLine has "schtasks", "Remote task", ProcessCommandLine matches regex @"(?i)sc(\.exe)?\s+\\\\", "Remote service", "SMB copy"), Source = DeviceName, DestinationIP = "", Destination = Target, Account = AccountName, Result = "ProcessCreated", Detail = ProcessCommandLine),
    // AT other devices: successful and failed logons whose source was this device.
    (DeviceLogonEvents | where TimeGenerated between (StartTime .. EndTime) | where RemoteIP in (DeviceIPs) | where DeviceName !contains DeviceCheck | extend Seen = "At the destination", Method = case(LogonType =~ "RemoteInteractive", "RDP", LogonType startswith "Network", "Network logon", LogonType =~ "NewCredentials", "NewCredentials", LogonType), Source = RemoteIP, DestinationIP = "", Destination = DeviceName, Account = strcat(AccountDomain, "\\", AccountName), Result = iff(isnotempty(FailureReason), strcat(ActionType, ": ", FailureReason), strcat(ActionType, iff(IsLocalAdmin == true, " (local admin)", ""))), Detail = strcat(LogonType, " logon by ", AccountName)),
    // AT other devices: files pushed onto them over SMB from this device. ADMIN$ and C$ drops are PsExec and friends.
    (DeviceFileEvents | where TimeGenerated between (StartTime .. EndTime) | where RequestSourceIP in (DeviceIPs) | where DeviceName !contains DeviceCheck | extend Seen = "At the destination", Method = strcat("File written over ", RequestProtocol), Source = RequestSourceIP, DestinationIP = "", Destination = DeviceName, Account = strcat(RequestAccountDomain, "\\", RequestAccountName), Result = ActionType, Detail = strcat(ShareName, " | ", FolderPath, " | SHA256=", SHA256)),
    // AT other devices: processes running in an RDP session that came from this device.
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where ProcessRemoteSessionIP in (DeviceIPs) | where DeviceName !contains DeviceCheck | summarize TimeGenerated = min(TimeGenerated), Processes = count(), Sample = make_set(ProcessCommandLine, 5) by DeviceName, AccountName, ProcessRemoteSessionIP | extend Seen = "At the destination", Method = "RDP session", Source = ProcessRemoteSessionIP, DestinationIP = "", Destination = DeviceName, Account = AccountName, Result = strcat(Processes, " processes"), Detail = strcat_array(Sample, " ; ")),
    // The domain controller's view (Defender for Identity): authentications and directory queries from this device.
    (IdentityLogonEvents | where TimeGenerated between (StartTime .. EndTime) | where isnotempty(DeviceCheck) | where IPAddress in (DeviceIPs) or DeviceName contains DeviceCheck | extend Seen = "Domain controller", Method = strcat(Protocol, " ", LogonType), Source = iff(isnotempty(DeviceName), DeviceName, IPAddress), DestinationIP = DestinationIPAddress, Destination = DestinationDeviceName, Account = iff(isnotempty(AccountUpn), AccountUpn, AccountName), Result = iff(isnotempty(FailureReason), strcat(ActionType, ": ", FailureReason), ActionType), Detail = Application),
    (IdentityQueryEvents | where TimeGenerated between (StartTime .. EndTime) | where isnotempty(DeviceCheck) | where IPAddress in (DeviceIPs) or DeviceName contains DeviceCheck | extend Seen = "Domain controller", Method = strcat(Protocol, " query"), Source = iff(isnotempty(DeviceName), DeviceName, IPAddress), DestinationIP = DestinationIPAddress, Destination = DestinationDeviceName, Account = iff(isnotempty(AccountUpn), AccountUpn, AccountName), Result = QueryType, Detail = strcat("target ", QueryTarget)),
    // The ACCOUNT: every device it logged on to in the window, and from where.
    (DeviceLogonEvents | where TimeGenerated between (StartTime .. EndTime) | where isnotempty(UserIdentityCheck) and AccountName contains UserIdentityCheck | where ActionType =~ "LogonSuccess" | where LogonType !in~ ("Service","Batch") | extend Seen = "Account footprint", Method = LogonType, Source = iff(isnotempty(RemoteDeviceName), RemoteDeviceName, RemoteIP), DestinationIP = "", Destination = DeviceName, Account = strcat(AccountDomain, "\\", AccountName), Result = strcat(ActionType, iff(IsLocalAdmin == true, " (local admin)", "")), Detail = strcat(LogonType, " from ", RemoteIP)),
    (IdentityLogonEvents | where TimeGenerated between (StartTime .. EndTime) | where isnotempty(UserIdentityCheck) and (AccountName contains UserIdentityCheck or AccountUpn contains UserIdentityCheck) | extend Seen = "Account footprint", Method = strcat(Protocol, " ", LogonType), Source = iff(isnotempty(DeviceName), DeviceName, IPAddress), DestinationIP = DestinationIPAddress, Destination = DestinationDeviceName, Account = iff(isnotempty(AccountUpn), AccountUpn, AccountName), Result = iff(isnotempty(FailureReason), strcat(ActionType, ": ", FailureReason), ActionType), Detail = Application)
| extend Window = case(TimeGenerated < IncidentStart, "1-Before", TimeGenerated <= IncidentEnd, "2-During", "3-After")
| extend LookupIP = iff(isnotempty(DestinationIP), DestinationIP, Destination)
| join kind=leftouter IpToDevice on $left.LookupIP == $right.IP
| summarize FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), Count = count(), Results = make_set(Result, 5), Detail = make_set(Detail, 5) by Window, Seen, Method, Source, Destination, ResolvedDevice, Account
| sort by FirstSeen asc
//
//| where Seen == "At the destination" and Results has "LogonSuccess"   // hops that worked, confirmed by the far end
//| where Seen == "Account footprint"                                   // the account's whole estate in the window
//| summarize Hops = make_set(iff(isnotempty(ResolvedDevice), ResolvedDevice, Destination), 100) by Window  // the list of devices to investigate next

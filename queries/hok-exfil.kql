//Hands-on-keyboard data exfiltration query
//
// Data moving away from the device: out to the internet, to another machine on the network,
// to a USB drive, back to the operator's own machine over RDP. Each row says where it went.
// Defender records connections, not bytes. Volume is filled in only where file sizes exist.
let IncidentStart = ago(1d);              // first known attacker activity, e.g. datetime(2026-10-05T14:32:00Z)
let IncidentEnd = now();
let LookBefore = 1d;
let LookAfter = 3d;
let DeviceCheck = "";                     // the device the data is leaving — fill this in
let UserIdentityCheck = "";               // optional: adds the account's mail and cloud channels
let InternalDomains = dynamic(["contoso.com"]);   // CHANGE THIS — every internal domain, or all mail looks external
let PrevalenceWindow = 30d;
let SustainedThreshold = 50;              // connections per hour from one process to one destination
//
let StartTime = IncidentStart - LookBefore;
let EndTime = IncidentEnd + LookAfter;
let Browsers = dynamic(["msedge.exe","chrome.exe","firefox.exe","brave.exe","opera.exe","iexplore.exe","msedgewebview2.exe"]);
let ExfilToolPattern = @"(?i)(rclone|megacmd|mega-put|megasync|winscp|filezilla|pscp|psftp|restic|azcopy|s3browser|gsutil|cyberduck)";
let UploadPattern = @"(?i)(curl(\.exe)?\s.*(\s-T\s|--upload-file|\s-F\s|--form|--data-binary\s+@)|invoke-(webrequest|restmethod).*-infile|-transfertype\s+upload|bitsadmin(\.exe)?\s.*/upload|ftp(\.exe)?\s+-s:|wget(\.exe)?\s.*--post-file|aws\s+s3\s+(cp|sync|mv)|scp(\.exe)?\s.*\S+@\S+:)";
let TunnelPattern = @"(?i)(ngrok|cloudflared|chisel|plink(\.exe)?\s.*-R\s|ssh(\.exe)?\s.*-R\s|frpc|gost|ligolo)";
let CopyOutPattern = @"(?i)\b(robocopy|xcopy|copy|copy-item|move|move-item)(\.exe)?\s.*\\\\[^\\\s]+\\";
// File-sharing and storage services. Legitimate in many estates; who used them, and how often the estate does, decides it.
let StorageHosts = dynamic(["mega.nz","mega.io","mega.co.nz","dropbox.com","dropboxusercontent.com","drive.google.com","storage.googleapis.com","onedrive.live.com","box.com","wetransfer.com","sendspace.com","mediafire.com","gofile.io","file.io","transfer.sh","temp.sh","pixeldrain.com","catbox.moe","anonfiles.com","bashupload.com","filebin.net","pcloud.com","icedrive.net","s3.amazonaws.com","api.telegram.org","discord.com","pastebin.com"]);
let FileTransferPorts = dynamic([20,21,22,69,139,445,873,989,990,2049,25,465,587]);
let MailClients = dynamic(["outlook.exe","olk.exe","hxoutlook.exe","thunderbird.exe"]);
let ArchiveTypes = @"(?i)\.(zip|7z|rar|tar|gz|tgz|cab)$";
// Every address the device held, so its copies can be found on the machines they landed on.
let DeviceIPs = DeviceNetworkInfo | where TimeGenerated between (StartTime .. EndTime) | where isnotempty(DeviceCheck) and DeviceName contains DeviceCheck | mv-expand IPEntry = IPAddresses | extend IP = tostring(IPEntry.IPAddress) | where isnotempty(IP) and IP !startswith "127." and IP != "::1" and IP !startswith "fe80" | distinct IP;
// Drive letters that were USB storage on this device in the window.
let UsbDrives = DeviceEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType in~ ("UsbDriveMount","UsbDriveMounted") | extend UdDrive = toupper(substring(tostring(todynamic(AdditionalFields).DriveLetter), 0, 1)) | where isnotempty(UdDrive) | project UdDeviceId = DeviceId, UdDrive | distinct UdDeviceId, UdDrive;
// Archives built on the device, so we can see what picked them up afterwards.
let Archives = materialize(DeviceFileEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType in~ ("FileCreated","FileRenamed","FileModified") | where FileName matches regex ArchiveTypes | where InitiatingProcessFileName !in~ ("msiexec.exe","TrustedInstaller.exe","MsMpEng.exe","svchost.exe") | summarize ArchiveTime = min(TimeGenerated), ArchiveSize = max(FileSize), ArchivePath = take_any(FolderPath) by ArDeviceId = DeviceId, ArchiveName = FileName);
//
let Rows = materialize(union isfuzzy=true
    // ---- TO THE INTERNET ----
    // Transfer tooling and upload commands. rclone with a remote is the single most common exfil tool in these cases.
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where FileName matches regex ExfilToolPattern or ProcessCommandLine matches regex ExfilToolPattern or ProcessCommandLine matches regex UploadPattern | extend Url = extract(@"(?i)((?:https?|ftp|sftp)://[^\s\x22\x27]+|\S+@[\w.-]+:\S*)", 1, ProcessCommandLine), RcloneRemote = extract(@"(?i)rclone(?:\.exe)?\x22?\s+(?:copy|sync|move|copyto|moveto)\s+\S+\s+([A-Za-z0-9_.-]{2,}):", 1, ProcessCommandLine) | extend From = "Device", Movement = "Transfer tool", Technique = iff(ProcessCommandLine has_any ("rclone","mega","s3","azcopy","gsutil"), "T1567.002", "T1048"), Actor = AccountName, Destination = iff(isnotempty(Url), Url, iff(isnotempty(RcloneRemote), strcat("rclone remote ", RcloneRemote), "")), Volume = "", Evidence = ProcessCommandLine, RanBy = InitiatingProcessFileName),
    // rclone's config file names the remote, and so the destination account.
    (DeviceFileEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where FileName =~ "rclone.conf" or FolderPath has @"\rclone\" | extend From = "Device", Movement = "Transfer tool config", Technique = "T1567.002", Actor = InitiatingProcessAccountName, Destination = "", Volume = "", Evidence = strcat(ActionType, " ", FolderPath), RanBy = InitiatingProcessFileName),
    // An archive built on the device and then named on a later command line — the hand-off from staging to sending.
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ProcessCommandLine has_any (toscalar(Archives | summarize make_set(ArchiveName, 200))) | join kind=inner Archives on $left.DeviceId == $right.ArDeviceId | where TimeGenerated > ArchiveTime and ProcessCommandLine contains ArchiveName | extend From = "Device", Movement = "Archive picked up", Technique = "T1560", Actor = AccountName, Destination = extract(@"(?i)((?:https?|ftp|sftp)://[^\s\x22\x27]+|\\\\[^\\\s]+\\[^\s\x22]*|\S+@[\w.-]+:\S*)", 1, ProcessCommandLine), Volume = format_bytes(ArchiveSize, 1), Evidence = strcat(ArchivePath, " -> ", ProcessCommandLine), RanBy = FileName),
    // Tunnels and reverse SSH. A way out that also brings the operator back in.
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where FileName matches regex TunnelPattern or ProcessCommandLine matches regex TunnelPattern | extend From = "Device", Movement = "Tunnel", Technique = "T1572", Actor = AccountName, Destination = "", Volume = "", Evidence = ProcessCommandLine, RanBy = InitiatingProcessFileName),
    // Storage and sharing services, by anything other than a browser.
    (DeviceNetworkEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType =~ "ConnectionSuccess" | where RemoteUrl has_any (StorageHosts) | where InitiatingProcessFileName !in~ (Browsers) | summarize TimeGenerated = min(TimeGenerated), Connections = count() by DeviceName, Actor = InitiatingProcessAccountName, RanBy = InitiatingProcessFileName, Destination = RemoteUrl, Slot = bin(TimeGenerated, 1h) | extend From = "Device", Movement = "Storage service (program)", Technique = "T1567.002", Volume = "", Evidence = strcat(Connections, " connections in the hour")),
    // Storage and sharing services in a browser. Uploading to MEGA or WeTransfer by hand looks exactly like this.
    (DeviceNetworkEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType =~ "ConnectionSuccess" | where RemoteUrl has_any (StorageHosts) | where InitiatingProcessFileName in~ (Browsers) | summarize TimeGenerated = min(TimeGenerated), Connections = count() by DeviceName, Actor = InitiatingProcessAccountName, RanBy = InitiatingProcessFileName, Destination = RemoteUrl, Slot = bin(TimeGenerated, 1h) | extend From = "Device", Movement = "Storage service (browser)", Technique = "T1567.002", Volume = "", Evidence = strcat(Connections, " connections in the hour")),
    // File-transfer protocols straight to the internet: FTP, SFTP/SCP, SMB, NFS, rsync, and SMTP from something that is not a mail client.
    (DeviceNetworkEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType =~ "ConnectionSuccess" and RemoteIPType == "Public" | where RemotePort in (FileTransferPorts) | where not(RemotePort in (25, 465, 587) and InitiatingProcessFileName in~ (MailClients)) | summarize TimeGenerated = min(TimeGenerated), Connections = count() by DeviceName, Actor = InitiatingProcessAccountName, RanBy = InitiatingProcessFileName, Destination = strcat(iff(isnotempty(RemoteUrl), RemoteUrl, RemoteIP), ":", RemotePort), Slot = bin(TimeGenerated, 1h) | extend From = "Device", Movement = "File-transfer protocol to the internet", Technique = "T1048", Volume = "", Evidence = strcat(Connections, " connections in the hour")),
    // DNS sent to an outside server by something that is not the resolver. Tunnelling looks like this.
    (DeviceNetworkEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType =~ "ConnectionSuccess" and RemoteIPType == "Public" and RemotePort == 53 | where InitiatingProcessFileName !in~ ("svchost.exe","dns.exe","lsass.exe") | summarize TimeGenerated = min(TimeGenerated), Connections = count() by DeviceName, Actor = InitiatingProcessAccountName, RanBy = InitiatingProcessFileName, Destination = RemoteIP, Slot = bin(TimeGenerated, 1h) | where Connections >= 20 | extend From = "Device", Movement = "DNS from a non-resolver", Technique = "T1048.003", Volume = "", Evidence = strcat(Connections, " DNS connections in the hour")),
    // Defender has no byte counts. A process hammering one public destination for an hour is the nearest proxy.
    (DeviceNetworkEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType =~ "ConnectionSuccess" and RemoteIPType == "Public" | where InitiatingProcessFileName !in~ (Browsers) | summarize TimeGenerated = min(TimeGenerated), Connections = count() by DeviceName, Actor = InitiatingProcessAccountName, RanBy = InitiatingProcessFileName, Destination = iff(isnotempty(RemoteUrl), RemoteUrl, RemoteIP), Slot = bin(TimeGenerated, 1h) | where Connections >= SustainedThreshold | extend From = "Device", Movement = "Sustained connection", Technique = "T1041", Volume = "", Evidence = strcat(Connections, " connections in the hour")),
    // ---- TO ANOTHER MACHINE ----
    // Files landing on other devices over SMB from this one, seen at the far end. Staging on a server before it leaves.
    (DeviceFileEvents | where TimeGenerated between (StartTime .. EndTime) | where RequestSourceIP in (DeviceIPs) | where DeviceName !contains DeviceCheck | where ActionType in~ ("FileCreated","FileModified","FileRenamed") | summarize TimeGenerated = min(TimeGenerated), Files = count(), Bytes = sum(FileSize), Sample = make_set(FileName, 5) by Destination = DeviceName, ShareName, Actor = RequestAccountName, Slot = bin(TimeGenerated, 1h) | extend From = "Device", Movement = "Copied to another device", Technique = "T1074.002", DeviceName = DeviceCheck, Volume = strcat(Files, " files, ", format_bytes(Bytes, 1)), Evidence = strcat("share ", ShareName, " | ", strcat_array(Sample, ", ")), RanBy = "SMB"),
    // Copy commands that name a share, seen at this end. The share can be the source rather than the target — read Evidence.
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ProcessCommandLine matches regex CopyOutPattern | extend From = "Device", Movement = "Copy command to a share", Technique = "T1074.002", Actor = AccountName, Destination = extract(@"(\\\\[^\\\s]+\\[^\s\x22]*)", 1, ProcessCommandLine), Volume = "", Evidence = ProcessCommandLine, RanBy = InitiatingProcessFileName),
    // Files written to \\tsclient — the drive of the machine the RDP session came from. The operator's own computer.
    (DeviceFileEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where FolderPath startswith @"\\tsclient\" | summarize TimeGenerated = min(TimeGenerated), Files = count(), Bytes = sum(FileSize), Sample = make_set(FileName, 5) by DeviceName, Actor = InitiatingProcessAccountName, RanBy = InitiatingProcessFileName, Slot = bin(TimeGenerated, 1h) | extend From = "Device", Movement = "Copied to RDP client", Technique = "T1041", Destination = @"\\tsclient", Volume = strcat(Files, " files, ", format_bytes(Bytes, 1)), Evidence = strcat_array(Sample, ", ")),
    (DeviceProcessEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ProcessCommandLine has "tsclient" | extend From = "Device", Movement = "Copied to RDP client", Technique = "T1041", Actor = AccountName, Destination = @"\\tsclient", Volume = "", Evidence = ProcessCommandLine, RanBy = InitiatingProcessFileName),
    // ---- TO REMOVABLE MEDIA ----
    // Files written to a drive letter that was USB storage in the window.
    (DeviceFileEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType in~ ("FileCreated","FileModified","FileRenamed") | where FolderPath matches regex @"^[A-Za-z]:\\" | extend Drive = toupper(substring(FolderPath, 0, 1)) | join kind=inner UsbDrives on $left.DeviceId == $right.UdDeviceId, $left.Drive == $right.UdDrive | summarize TimeGenerated = min(TimeGenerated), Files = count(), Bytes = sum(FileSize), Sample = make_set(FileName, 5) by DeviceName, Drive, Actor = InitiatingProcessAccountName, RanBy = InitiatingProcessFileName, Slot = bin(TimeGenerated, 1h) | extend From = "Device", Movement = "Copied to USB", Technique = "T1052.001", Destination = strcat(Drive, ":"), Volume = strcat(Files, " files, ", format_bytes(Bytes, 1)), Evidence = strcat_array(Sample, ", ")),
    // What device control recorded: storage connected, and file access it audited or blocked.
    (DeviceEvents | where TimeGenerated between (StartTime .. EndTime) | where DeviceName contains DeviceCheck | where ActionType in~ ("UsbDriveMount","UsbDriveMounted","RemovableStoragePolicyTriggered","RemovableStorageFileEvent") | extend From = "Device", Movement = "Removable media (device control)", Technique = "T1052.001", Actor = iff(isnotempty(InitiatingProcessAccountName), InitiatingProcessAccountName, AccountName), Destination = tostring(todynamic(AdditionalFields).DriveLetter), Volume = "", Evidence = strcat(ActionType, " | ", tostring(AdditionalFields)), RanBy = InitiatingProcessFileName),
    // ---- FROM THE ACCOUNT, WHEREVER IT WAS USED ----
    (EmailEvents | where TimeGenerated between (StartTime .. EndTime) | where isnotempty(UserIdentityCheck) | where SenderFromAddress contains UserIdentityCheck | where EmailDirection =~ "Outbound" and AttachmentCount > 0 | where RecipientDomain !in~ (InternalDomains) | extend From = "Account", Movement = "Mail out", Technique = "T1048", DeviceName = "", Actor = SenderFromAddress, Destination = RecipientEmailAddress, Volume = strcat(AttachmentCount, " attachments"), Evidence = Subject, RanBy = ""),
    (CloudAppEvents | where TimeGenerated between (StartTime .. EndTime) | where isnotempty(UserIdentityCheck) | where ActionType in~ ("AnonymousLinkCreated","AnonymousLinkUsed","SharingInvitationCreated","SharingSet","AddedToSecureLink") | extend Actor = iff(isnotempty(tostring(RawEventData.UserId)), tostring(RawEventData.UserId), AccountDisplayName) | where Actor contains UserIdentityCheck | extend From = "Account", Movement = "Cloud sharing", Technique = "T1567", DeviceName = "", Destination = tostring(RawEventData.TargetUserOrGroupName), Volume = "", Evidence = strcat(ActionType, " | ", ObjectName), RanBy = strcat(IPAddress, " ", ISP)),
    (CloudAppEvents | where TimeGenerated between (StartTime .. EndTime) | where isnotempty(UserIdentityCheck) | where ActionType in~ ("FileDownloaded","FileSyncDownloadedFull") | extend Actor = iff(isnotempty(tostring(RawEventData.UserId)), tostring(RawEventData.UserId), AccountDisplayName) | where Actor contains UserIdentityCheck | summarize TimeGenerated = min(TimeGenerated), Files = count(), Sample = make_set(ObjectName, 5) by Actor, IPAddress, ISP, Slot = bin(TimeGenerated, 1h) | where Files >= 20 | extend From = "Account", Movement = "Cloud bulk download", Technique = "T1530", DeviceName = "", Destination = strcat(IPAddress, " ", ISP), Volume = strcat(Files, " files"), Evidence = strcat_array(Sample, " ; "), RanBy = "")
| where Actor contains UserIdentityCheck or From == "Device"
| extend Window = case(TimeGenerated < IncidentStart, "1-Before", TimeGenerated <= IncidentEnd, "2-During", "3-After"));
// How common each internet destination is across the estate. One that nobody else uses is the one to read first.
let Destinations = Rows | where Movement in ("Storage service (program)","Storage service (browser)","Sustained connection","DNS from a non-resolver") | distinct Destination;
let Prevalence = DeviceNetworkEvents | where TimeGenerated > ago(PrevalenceWindow) | where RemoteIPType == "Public" | extend Destination = iff(isnotempty(RemoteUrl), RemoteUrl, RemoteIP) | where Destination in (Destinations) | summarize OrgDevices = dcount(DeviceId) by Destination;
//
Rows
| join kind=leftouter Prevalence on Destination
| project-rename EventTime = TimeGenerated
| project EventTime, Window, From, Movement, Technique, DeviceName, Actor, Destination, Volume, OrgDevices, Evidence, RanBy
| sort by EventTime asc
//
//| where From == "Device"                                        // only what left this device
//| where Movement in ("Copied to another device","Copy command to a share")  // internal staging — the step before it leaves the network
//| where Movement in ("Copied to USB","Copied to RDP client")    // physically or interactively carried off
//| where Movement == "Sustained connection" and OrgDevices <= 2  // heavy traffic to somewhere almost nobody else talks to
//| where Window == "3-After"                                     // still leaving after you thought it was over
//| summarize First = min(EventTime), Last = max(EventTime), Rows = count(), Volume = make_set(Volume, 5) by From, Movement, Destination  // one line per way out
